{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "drizzle.*.config.ts",
    "playwright*.config.ts",
    "scripts/**/*.{mjs,ts}",
    "e2e/**/*.ts",
    "src/**/__checks__/*.ts",
    "src/**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "scripts/**/*.{mjs,ts}",
    "e2e/**/*.ts",
    "*.{ts,mjs}"
  ],
  "ignore": [
    "src/lib/db-schema/**",
    "src/app/(admin)/vouchers/actions.ts",
    "src/app/(admin)/vouchers/create-dialog.tsx",
    "src/app/(antifraud)/antifraud/_components/live-feed.tsx",
    "src/lib/api-auth/endpoints.ts",
    "src/lib/queries/dashboard-deposit-funded-ggr.ts",
    "src/lib/queries/fiat-withdrawal-review.ts",
    "src/lib/queries/insights-analytics/overview.ts",
    "src/lib/queries/insights-rewards/motha/overview.ts",
    "src/lib/queries/insights-rewards/signup/_shared.ts",
    "src/lib/queries/insights-rewards/signup/overview.ts"
  ],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved"
  ],
  "ignoreDependencies": [
    "server-only",
    "geojson",
    "topojson-specification",
    "eslint-config-next"
  ]
}
