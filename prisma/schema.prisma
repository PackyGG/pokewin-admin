generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  userId                String
  accountId             String    @unique(map: "account_accountId_unique")
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @db.Timestamp(6)
  scope                 String?
  idToken               String?
  password              String?
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_userId_user_id_fk")

  @@index([userId], map: "idx_account_user_id")
}

model active_seeds {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @unique(map: "active_seeds_user_id_unique")
  client_seed      String
  server_seed      String?
  server_seed_hash String?
  nonce            Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @db.Timestamp(6)
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "active_seeds_user_id_user_id_fk")
}

model affiliate_accounts {
  user_id                     String    @id
  total_referred              Int       @default(0)
  total_wager_volume_usd      Decimal   @default(0) @db.Decimal(20, 2)
  total_earned_usd            Decimal   @default(0) @db.Decimal(20, 2)
  available_usd               Decimal   @default(0) @db.Decimal(20, 2)
  total_paid_out_usd          Decimal   @default(0) @db.Decimal(20, 2)
  total_bonus_distributed_usd Decimal   @default(0) @db.Decimal(20, 2)
  last_payout_at              DateTime? @db.Timestamp(6)
  created_at                  DateTime  @default(now()) @db.Timestamp(6)
  updated_at                  DateTime  @default(now()) @db.Timestamp(6)
  user                        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "affiliate_accounts_user_id_user_id_fk")
}

model affiliate_clicks {
  id         Int       @id @default(autoincrement())
  code       String    @db.VarChar(20)
  user_agent String?
  ip         String    @db.VarChar(45)
  country    String    @default("unknown") @db.VarChar(100)
  region     String    @default("unknown") @db.VarChar(100)
  city       String    @default("unknown") @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([code], map: "idx_affiliate_clicks_code")
  @@index([created_at], map: "idx_affiliate_clicks_created_at")
  @@index([ip], map: "idx_affiliate_clicks_ip")
}

model affiliate_code_queue {
  user_id    String   @id
  code       String
  expires_at DateTime @db.Timestamp(6)
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "affiliate_code_queue_user_id_user_id_fk")
}

model affiliate_code_usages {
  id                                                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_user_id                                  String
  code                                               String
  referred_user_id                                   String
  deposit_amount_usd                                 Decimal              @default(0) @db.Decimal(20, 2)
  referrer_cut_usd                                   Decimal              @default(0) @db.Decimal(20, 2)
  user_bonus_usd                                     Decimal              @default(0) @db.Decimal(20, 2)
  status                                             String               @default("completed")
  usage_type                                         affiliate_usage_type @default(deposit)
  wager_amount_usd                                   Decimal              @default(0) @db.Decimal(20, 2)
  game_session_id                                    String?              @db.Uuid
  created_at                                         DateTime             @default(now()) @db.Timestamp(6)
  updated_at                                         DateTime             @default(now()) @db.Timestamp(6)
  user_affiliate_code_usages_affiliate_user_idTouser User                 @relation("affiliate_code_usages_affiliate_user_idTouser", fields: [affiliate_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "affiliate_code_usages_affiliate_user_id_user_id_fk")
  game_sessions                                      game_sessions?       @relation(fields: [game_session_id], references: [id], onUpdate: NoAction, map: "affiliate_code_usages_game_session_id_game_sessions_id_fk")
  user_affiliate_code_usages_referred_user_idTouser  User                 @relation("affiliate_code_usages_referred_user_idTouser", fields: [referred_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "affiliate_code_usages_referred_user_id_user_id_fk")

  @@index([affiliate_user_id, created_at(sort: Desc)], map: "idx_acu_affiliate_user_created_at")
  @@index([referred_user_id, code, usage_type], map: "idx_acu_referred_user_code_usage")
  // Functional index — not expressible in Prisma schema; created in prod via prisma/recommended-indexes.sql:
  //   CREATE INDEX idx_acu_upper_code_usage_created_at ON affiliate_code_usages (UPPER(code), usage_type, created_at);
}

model affiliate_payouts {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_user_id String
  amount_usd        Decimal                 @default(0) @db.Decimal(20, 2)
  status            affiliate_payout_status @default(pending)
  metadata          Json?
  created_at        DateTime                @default(now()) @db.Timestamp(6)
  updated_at        DateTime                @default(now()) @db.Timestamp(6)
  user              User                    @relation(fields: [affiliate_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "affiliate_payouts_affiliate_user_id_user_id_fk")
}

model affiliate_codes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String
  code       String   @unique(map: "affiliate_codes_code_unique")
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "affiliate_codes_user_id_user_id_fk")
}

model affiliate_level_configs {
  level           Int      @id
  label           String
  commission_rate Decimal  @db.Decimal(5, 4)
  updated_at      DateTime @updatedAt @db.Timestamp(6)
  threshold       Decimal  @default(0) @db.Decimal(20, 2)
}

model audit_events {
  id           String           @id
  user_id      String?
  event_type   audit_event_type
  ip           String?          @db.Inet
  user_agent   String?
  country      String?
  country_code String?
  metadata     Json?
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  user         User?            @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_events_user_id_user_id_fk")
}

model balances {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String               @unique(map: "balances_user_id_unique")
  available_balance   Decimal              @default(0) @db.Decimal(20, 2)
  locked_balance      Decimal              @default(0) @db.Decimal(20, 2)
  total_deposited     Decimal              @default(0) @db.Decimal(20, 2)
  total_withdrawn     Decimal              @default(0) @db.Decimal(20, 2)
  total_wagered       Decimal              @default(0) @db.Decimal(20, 2)
  total_won           Decimal              @default(0) @db.Decimal(20, 2)
  bonus_points        Int                  @default(0)
  last_transaction_id String?              @db.Uuid
  unlock_at           DateTime?            @db.Timestamp(6)
  version             Int                  @default(1)
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  updated_at          DateTime             @default(now()) @db.Timestamp(6)
  ledger_transactions ledger_transactions? @relation(fields: [last_transaction_id], references: [id], onUpdate: NoAction, map: "balances_last_transaction_id_ledger_transactions_id_fk")
  user                User                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "balances_user_id_user_id_fk")
}

model battle_backgrounds {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique(map: "battle_backgrounds_name_unique") @db.VarChar(100)
  image_url  String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

model battle_participants {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  battle_id       String        @db.Uuid
  game_session_id String        @unique(map: "battle_participants_game_session_id_unique") @db.Uuid
  user_id         String?
  bot_id          String?       @db.Uuid
  team_number     Int
  team_position   Int           @default(0)
  client_seed     String
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  battles         battles       @relation(fields: [battle_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "battle_participants_battle_id_battles_id_fk")
  bots            bots?         @relation(fields: [bot_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "battle_participants_bot_id_bots_id_fk")
  game_sessions   game_sessions @relation(fields: [game_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "battle_participants_game_session_id_game_sessions_id_fk")
  user            User?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "battle_participants_user_id_user_id_fk")

  @@index([battle_id], map: "idx_battle_participants_battle_id")
}

model battles {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String
  mode                      battle_mode
  pack_ids                  String[]
  teams                     Int
  players_per_team          Int
  status                    battle_status
  bet_amount                Decimal                 @db.Decimal(20, 2)
  winner_team               Int?
  server_seed               String
  server_seed_hash          String
  eos_block_hash            String?
  region_code               region_code             @default(NA)
  additional_settings       String[]                @default([])
  animation_complete_at     DateTime?               @db.Timestamp(6)
  password                  String?
  sponsorship_percentage    Int                     @default(0)
  sponsorship_amount_paid   Decimal                 @default(0) @db.Decimal(20, 2)
  borrow_percentage         Int                     @default(0)
  total_unpacked            Decimal?                @db.Decimal(20, 2)
  pending_distribution_data Json?
  created_at                DateTime                @default(now()) @db.Timestamp(6)
  updated_at                DateTime                @default(now()) @db.Timestamp(6)
  battle_participants       battle_participants[]
  user                      User                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "battles_user_id_user_id_fk")
  provably_fair_results     provably_fair_results[]

  @@index([status, created_at], map: "idx_battles_status_created_at")
  @@index([user_id, status, created_at(sort: Desc)], map: "idx_battles_user_id_status_created_at")
}

model bots {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String                @unique(map: "bots_username_unique") @db.VarChar(50)
  image_url           String?
  total_wagered_usd   Decimal               @default(0) @db.Decimal(20, 2)
  total_won_usd       Decimal               @default(0) @db.Decimal(20, 2)
  total_lost_usd      Decimal               @default(0) @db.Decimal(20, 2)
  battles_played      Int                   @default(0)
  battles_won         Int                   @default(0)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  battle_participants battle_participants[]
}

model card_withdrawal_requests {
  id                                               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                          String
  method                                           card_withdrawal_method
  inventory_item_ids                               String[]               @default([]) @db.Uuid
  voucher_ids                                      String[]               @default([]) @db.Uuid
  total_value_usd                                  Decimal                @db.Decimal(20, 2)
  shipping_address_snapshot                        Json?
  shipping_fee_usd                                 Decimal?               @db.Decimal(10, 2)
  tracking_number                                  String?
  carrier                                          String?
  crypto_asset                                     String?
  crypto_amount                                    Decimal?               @db.Decimal(20, 8)
  exchange_rate                                    Decimal?               @db.Decimal(20, 8)
  destination_address                              String?
  fireblocks_tx_id                                 String?                @unique(map: "card_withdrawal_requests_fireblocks_tx_id_unique")
  tx_hash                                          String?
  status                                           card_withdrawal_status @default(pending)
  failure_reason                                   String?
  requested_at                                     DateTime               @default(now()) @db.Timestamp(6)
  processing_at                                    DateTime?              @db.Timestamp(6)
  shipped_at                                       DateTime?              @db.Timestamp(6)
  completed_at                                     DateTime?              @db.Timestamp(6)
  failed_at                                        DateTime?              @db.Timestamp(6)
  cancelled_at                                     DateTime?              @db.Timestamp(6)
  processed_by                                     String?
  shipped_by                                       String?
  requires_confirmation                            Boolean                @default(false)
  confirmation_reason                              String?
  confirmed_at                                     DateTime?              @db.Timestamp(6)
  confirmed_by                                     String?
  ip_address                                       String?
  metadata                                         Json?
  created_at                                       DateTime               @default(now()) @db.Timestamp(6)
  updated_at                                       DateTime               @default(now()) @db.Timestamp(6)
  user_card_withdrawal_requests_confirmed_byTouser User?                  @relation("card_withdrawal_requests_confirmed_byTouser", fields: [confirmed_by], references: [id], onUpdate: NoAction, map: "card_withdrawal_requests_confirmed_by_user_id_fk")
  user_card_withdrawal_requests_processed_byTouser User?                  @relation("card_withdrawal_requests_processed_byTouser", fields: [processed_by], references: [id], onUpdate: NoAction, map: "card_withdrawal_requests_processed_by_user_id_fk")
  user_card_withdrawal_requests_shipped_byTouser   User?                  @relation("card_withdrawal_requests_shipped_byTouser", fields: [shipped_by], references: [id], onUpdate: NoAction, map: "card_withdrawal_requests_shipped_by_user_id_fk")
  user_card_withdrawal_requests_user_idTouser      User                   @relation("card_withdrawal_requests_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "card_withdrawal_requests_user_id_user_id_fk")

  @@index([status, completed_at(sort: Desc)], map: "idx_cwr_status_completed_at")
  @@index([user_id, status], map: "idx_cwr_user_id_status")
}

model cards {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  image_url    String
  price        Decimal      @db.Decimal(20, 2)
  price_raw    Decimal      @db.Decimal(20, 2)
  hp           Int?         @default(0)
  cost         Int?
  power        Int?
  rarity       String?
  artist       String?
  card_number  String?
  type         String       @default("card")
  tcgplayer_id Int?         @unique(map: "cards_tcgplayer_id_unique")
  set_id       String?      @db.Uuid
  created_at   DateTime     @default(now()) @db.Timestamp(6)
  updated_at   DateTime     @default(now()) @db.Timestamp(6)
  sets         sets?        @relation(fields: [set_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cards_set_id_sets_id_fk")
  pack_cards   pack_cards[]

  @@index([card_number], map: "idx_cards_card_number")
  @@index([type], map: "idx_cards_type")
}

model chat_messages {
  id                                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                             String
  content                             String
  is_deleted                          Boolean               @default(false)
  deleted_at                          DateTime?             @db.Timestamp(6)
  deleted_by                          String?
  created_at                          DateTime              @default(now()) @db.Timestamp(6)
  updated_at                          DateTime              @default(now()) @db.Timestamp(6)
  user_chat_messages_deleted_byTouser User?                 @relation("chat_messages_deleted_byTouser", fields: [deleted_by], references: [id], onUpdate: NoAction, map: "chat_messages_deleted_by_user_id_fk")
  user_chat_messages_user_idTouser    User                  @relation("chat_messages_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_messages_user_id_user_id_fk")
  pinned_chat_messages                pinned_chat_messages?
}

model country_restrictions {
  country_code              String   @id
  blocked                   Boolean  @default(false)
  physical_withdrawal       Boolean  @default(true)
  digital_withdrawal        Boolean  @default(true)
  gift_card_deposit         Boolean  @default(true)
  promo_code_deposit        Boolean  @default(true)
  locked_deposits_crypto    String[] @default([])
  locked_deposits_fiat      String[] @default([])
  locked_withdrawals_crypto String[] @default([])
  created_at                DateTime @default(now()) @db.Timestamp(6)
  updated_at                DateTime @default(now()) @db.Timestamp(6)
}

model creator_withdrawal_limits {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String    @unique(map: "creator_withdrawal_limits_user_id_unique")
  currency_limit_amount     Decimal?  @db.Decimal(20, 2)
  currency_limit_start_date DateTime? @db.Timestamp(6)
  currency_limit_reset_days Int?
  percentage_limit          Decimal?  @db.Decimal(5, 4)
  created_at                DateTime  @default(now()) @db.Timestamp(6)
  updated_at                DateTime  @default(now()) @db.Timestamp(6)
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "creator_withdrawal_limits_user_id_user_id_fk")
}

model user_battle_limits {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @unique(map: "user_battle_limits_user_id_unique")
  max_value_usd      Decimal? @db.Decimal(20, 2)
  base_bet_limit_usd Decimal? @db.Decimal(20, 2)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @db.Timestamp(6)
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_battle_limits_user_id_user_id_fk")

  @@index([user_id], map: "user_battle_limits_user_id_idx")
}

model deposit_addresses {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String
  vault_id            String                @db.Uuid
  asset_id            String
  address             String
  tag                 String?
  legacy_address      String?
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  user                User                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "deposit_addresses_user_id_user_id_fk")
  vaults              vaults                @relation(fields: [vault_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "deposit_addresses_vault_id_vaults_id_fk")
  ledger_transactions ledger_transactions[]
}

model game_sessions {
  id                                                                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                                 String?
  bot_id                                                                  String?                 @db.Uuid
  game_type                                                               game_type
  game_id                                                                 String                  @db.Uuid
  bet_amount                                                              Decimal                 @db.Decimal(20, 2)
  result                                                                  game_session_result?
  bet_ledger_tx_id                                                        String?                 @db.Uuid
  user_reward_id                                                          String?                 @db.Uuid
  created_at                                                              DateTime                @default(now()) @db.Timestamp(6)
  updated_at                                                              DateTime                @default(now()) @db.Timestamp(6)
  affiliate_code_usages                                                   affiliate_code_usages[]
  battle_participants                                                     battle_participants?
  ledger_transactions_game_sessions_bet_ledger_tx_idToledger_transactions ledger_transactions?    @relation("game_sessions_bet_ledger_tx_idToledger_transactions", fields: [bet_ledger_tx_id], references: [id], onUpdate: NoAction, map: "game_sessions_bet_ledger_tx_id_ledger_transactions_id_fk")
  user                                                                    User?                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "game_sessions_user_id_user_id_fk")
  ledger_transactions_ledger_transactions_game_session_idTogame_sessions  ledger_transactions[]   @relation("ledger_transactions_game_session_idTogame_sessions")
  provably_fair_results                                                   provably_fair_results[]

  @@index([user_id, created_at(sort: Desc)], map: "idx_gs_user_id_created_at")
  @@index([game_type, created_at(sort: Desc)], map: "idx_gs_game_type_created_at")
  @@index([game_id], map: "idx_gs_game_id")
}

model gift_cards {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String?              @db.VarChar(32)
  code_hash           String?              @db.VarChar(64)
  value               Decimal              @db.Decimal(20, 2)
  region              gift_card_region
  redeemed_at         DateTime?            @db.Timestamp(6)
  redeemed_by_user_id String?
  ledger_tx_id        String?              @db.Uuid
  expires_at          DateTime?            @db.Timestamp(6)
  metadata            Json?
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  updated_at          DateTime             @default(now()) @db.Timestamp(6)
  ledger_transactions ledger_transactions? @relation(fields: [ledger_tx_id], references: [id], onUpdate: NoAction, map: "gift_cards_ledger_tx_id_ledger_transactions_id_fk")
  user                User?                @relation(fields: [redeemed_by_user_id], references: [id], onUpdate: NoAction, map: "gift_cards_redeemed_by_user_id_user_id_fk")
}

model ledger_transactions {
  id                                                                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                           String
  type                                                              ledger_transaction_type
  amount                                                            Decimal                   @db.Decimal(20, 2)
  balance_before                                                    Decimal                   @db.Decimal(20, 2)
  balance_after                                                     Decimal                   @db.Decimal(20, 2)
  game_session_id                                                   String?                   @db.Uuid
  crypto_asset                                                      String?
  crypto_amount                                                     Decimal?                  @db.Decimal(20, 8)
  exchange_rate                                                     Decimal?                  @db.Decimal(20, 8)
  fireblocks_tx_id                                                  String?                   @unique(map: "ledger_transactions_fireblocks_tx_id_unique")
  external_tx_id                                                    String?                   @unique(map: "ledger_transactions_external_tx_id_unique")
  blockchain_tx_hash                                                String?
  source_address                                                    String?
  destination_address                                               String?
  deposit_address_id                                                String?                   @db.Uuid
  status                                                            ledger_transaction_status
  failure_reason                                                    String?
  description                                                       String
  metadata                                                          Json?
  created_at                                                        DateTime                  @default(now()) @db.Timestamp(6)
  updated_at                                                        DateTime                  @default(now()) @db.Timestamp(6)
  balances                                                          balances[]
  game_sessions_game_sessions_bet_ledger_tx_idToledger_transactions game_sessions[]           @relation("game_sessions_bet_ledger_tx_idToledger_transactions")
  gift_cards                                                        gift_cards[]
  deposit_addresses                                                 deposit_addresses?        @relation(fields: [deposit_address_id], references: [id], onUpdate: NoAction, map: "ledger_transactions_deposit_address_id_deposit_addresses_id_fk")
