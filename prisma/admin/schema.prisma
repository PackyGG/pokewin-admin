generator client {
  provider = "prisma-client"
  output   = "../../src/generated/admin-prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_users {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String               @unique
  username       String               @unique
  password_hash  String
  role           admin_role           @default(admin)
  // Optional FK to admin_roles. Nullable so existing users keep working on
  // the hardcoded `role` enum during transition. Once a role_id is set it
  // takes precedence over the enum-based system-role defaults.
  role_id        String?              @db.Uuid
  custom_role    admin_roles?         @relation(fields: [role_id], references: [id], onDelete: SetNull)
  totp_secret    String?
  totp_enabled   Boolean              @default(false)
  recovery_codes String[]
  is_active      Boolean              @default(true)
  // Profile fields (editable by the admin themselves on /profile).
  // display_username: label shown in the header/UI; falls back to `username` when null.
  // profile_image / profile_image_mime: raw avatar bytes + MIME stored directly in DB.
  display_username   String?
  profile_image      Bytes?
  profile_image_mime String?
  // Per-user preferences (theme, timezone, date format, etc.). See
  // src/lib/admin-preferences.ts for the typed shape. JSONB so we can
  // add new preference slots without a migration per field.
  preferences        Json?                @db.JsonB
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @updatedAt @db.Timestamptz(6)
  audit_events          admin_audit_events[]
  sessions              admin_sessions[]
  notes                 admin_notes[]
  allowed_pages         String[]
  gift_card_actions     admin_gift_card_actions[]
  voucher_actions       admin_voucher_actions[]
  expenses              expenses[]
  recurring_expenses    recurring_expenses[]
  shifts_created        admin_shifts[]              @relation("admin_shifts_created_by")
  shift_assignments     admin_shift_assignments[]
  salary_employees      salary_employees[]
  salary_payouts        salary_payouts[]
  excluded_users         excluded_users[]
  giveaway_actions       admin_giveaway_actions[]
  user_tags              admin_user_tags[]
}

/// Admin-DB metadata for balance adjustments tagged as "Giveaway" on the
/// /users/[id] adjust-balance flow. Stored separately from the main-DB
/// ledger row because:
///   • the source URL (Twitter / Discord) is admin-internal — no reason
///     to expose it on the user-facing ledger,
///   • we can't cross-DB FK into ledger_transactions (different
///     PostgreSQL databases),
///   • the /marketing/giveaway page only needs the admin-side data
///     anyway (user_id + amount + source).
///
/// `ledger_tx_id` is stored as TEXT (not a real FK) so we can still
/// cross-reference each giveaway row back to the ledger event that
/// funded it for auditing — no constraint, just a reference.
model admin_giveaway_actions {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  /// packy.gg user.id (text, not UUID — better-auth nanoid).
  target_user_id String
  /// Signed USD amount that actually landed on the user's balance.
  /// Mirrors the ledger row's `amount` field for self-contained
  /// display on the giveaway page without a cross-DB lookup.
  amount_usd     Decimal     @db.Decimal(20, 2)
  /// Full URL the giveaway was advertised at (tweet / Discord
  /// message). Validated server-side against an allowlist of hosts.
  source_url     String
  /// Derived from `source_url` host at write time. Cached so the
  /// list page doesn't need to re-parse 1000 URLs to draw badges.
  /// One of: "twitter" | "discord" | "other".
  source_type    String
  /// Optional free-text reason the admin entered (mirrors the
  /// `reason` argument to adjustBalance). Useful when multiple
  /// admins want to remember WHY this specific giveaway happened
  /// beyond just the source URL.
  reason         String?
  /// Cross-reference to the main-DB ledger row this giveaway funded.
  /// Stored as TEXT because the main DB lives in a separate Postgres
  /// — Prisma can't enforce a real FK here. Always set in practice
  /// because the giveaway row is only written AFTER the ledger
  /// transaction succeeds.
  ledger_tx_id   String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])

  @@index([created_at(sort: Desc)], map: "admin_giveaway_actions_created_at_idx")
  @@index([target_user_id], map: "admin_giveaway_actions_target_user_id_idx")
}

/// Admin-set VIP tags on packy.gg users. Lives in the admin DB because
/// it's admin-internal CRM metadata — never exposed to the user side
/// and not part of the game DB's user schema (we can't cross-DB FK to
/// the main `user` table anyway).
///
/// Two tags supported today, enforced by the `tag` text + a CHECK
/// constraint at the SQL layer (see migration):
///   • contacted_vip — sales/CRM reached out to this user
///   • confirmed_vip — user is verified as an active VIP (deposits,
///     wagers, communication patterns, etc.)
///
/// Each (user, tag) pair is unique — re-tagging is idempotent. Removing
/// a tag is a DELETE; we don't soft-delete because the audit trail
/// already lives in `admin_audit_events`.
model admin_user_tags {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg user_id (text — main DB lives in a separate Postgres
  // cluster, can't be an FK).
  target_user_id  String
  // Tag value — currently 'contacted_vip' | 'confirmed_vip'.
  // The set is also enforced server-side in the action (Zod enum) so
  // even if a future code path bypasses the SQL CHECK we still catch
  // bad values.
  tag             String
  // Who set the tag. Used for the audit panel and to know which admin
  // owns a CRM assignment.
  set_by_admin_id String      @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  admin_user      admin_users @relation(fields: [set_by_admin_id], references: [id])

  @@unique([target_user_id, tag], map: "admin_user_tags_user_tag_unique")
  @@index([target_user_id], map: "admin_user_tags_target_user_id_idx")
  @@index([tag], map: "admin_user_tags_tag_idx")
}

// Admin-managed blacklist of packy.gg user IDs whose activity should
// NOT count toward dashboard / analytics / PnL / wager metrics. Used
// for excluding internal test accounts, hand-picked outliers, and
// staff users who happen to play. Race-related queries (rakeback,
// leaderboards, race claims) intentionally IGNORE this list — the
// user explicitly asked for races to keep counting blacklisted
// users so leaderboard positions don't shift when an exclusion
// lands.
//
// Storage notes:
//   • Primary key IS the packy.gg user_id — a user can only be
//     excluded once and the row IS the exclusion record.
//   • `excluded_by` references admin_users.id so we know who added
//     each entry. We could soft-delete instead of hard-delete, but
//     the audit table already captures every add/remove event, so a
//     hard delete is fine — the history lives there.
model excluded_users {
  user_id     String      @id
  reason      String?
  excluded_by String      @db.Uuid
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @updatedAt      @db.Timestamptz(6)
  admin_user  admin_users @relation(fields: [excluded_by], references: [id], onDelete: Restrict)

  @@index([created_at(sort: Desc)], map: "excluded_users_created_at_idx")
}

// Custom role definitions for the granular-permissions system. Four
// `is_system = true` rows (admin, support, marketing, creator) are seeded
// by prisma/admin/seed.ts and map to the hardcoded admin_role enum values.
// Additional rows created through the admin UI carry `is_system = false`
// and can be freely edited / deleted.
//
// `capabilities` is a string[] of keys from src/lib/permissions.ts
// (CapabilityKey). Both page access (`pages.*`) and action capabilities
// (`domain.action`) live in this single array.
model admin_roles {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique
  description  String?
  is_system    Boolean       @default(false)
  capabilities String[]      @default([])
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @updatedAt        @db.Timestamptz(6)
  admin_users  admin_users[]
}

model admin_sessions {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  ip             String?
  user_agent     String?
  auth_method    String?
  logged_in_at   DateTime    @default(now()) @db.Timestamptz(6)
  expires_at     DateTime    @db.Timestamptz(6)
  logged_out_at  DateTime?   @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])
}

model admin_notes {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  target_user_id String
  content        String
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])
}

model admin_audit_events {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String?      @db.Uuid
  event_type     String
  target_user_id String?
  ip             String?
  metadata       Json?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  admin_user     admin_users? @relation(fields: [admin_user_id], references: [id])
}

model admin_gift_card_actions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gift_card_id     String    @db.Uuid
  action           String    // "created" | "cancelled"
  admin_user_id    String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  admin_user       admin_users @relation(fields: [admin_user_id], references: [id])

  @@index([gift_card_id])
}

model admin_voucher_actions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_id       String    @db.Uuid
  action           String    // "created"
  admin_user_id    String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  admin_user       admin_users @relation(fields: [admin_user_id], references: [id])

  @@index([voucher_id])
}

model creator_webhooks {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id  String
  url             String
  secret          String
  type            webhook_type
  enabled         Boolean      @default(true)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([target_user_id])
}

model creator_deals {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id        String
  deal_name             String?
  deal_type             deal_type
  amount                Decimal     @db.Decimal(20, 2)
  currency              String      @default("USD") @db.VarChar(10)
  start_date            DateTime    @db.Timestamptz(6)
  end_date              DateTime?   @db.Timestamptz(6)
  status                deal_status @default(active)
  notes                 String?
  // Balance fill settings
  daily_fill_amount     Decimal?    @db.Decimal(20, 2)
  daily_fill_time       String?     @db.VarChar(5) // "HH:MM" UTC
  daily_fill_enabled    Boolean     @default(false)
  keep_percentage       Decimal?    @db.Decimal(5, 4) // e.g. 0.2000 = 20%
  // Withdrawal limits (synced to creator_withdrawal_limits on main DB)
  currency_limit_amount   Decimal?  @db.Decimal(20, 2)
  currency_limit_reset_days Int?
  percentage_limit        Decimal?  @db.Decimal(5, 4)
  tip_limit               Decimal?  @db.Decimal(20, 2)
  tip_limit_reset_days    Int?
  // Leaderboard
  leaderboard_prize_pool  Decimal?  @db.Decimal(20, 2)
  leaderboard_our_share   Decimal?  @db.Decimal(5, 4) // e.g. 0.5000 = 50%
  leaderboard_frequency   String?   @db.VarChar(20) // "weekly", "biweekly", "monthly"
  // Stream requirements
  min_stream_minutes    Int?
  // Computed/manual risk
  max_financial_exposure Decimal?   @db.Decimal(20, 2)
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime    @default(now()) @db.Timestamptz(6)

  @@index([target_user_id])
}

model creator_socials {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id    String
  platform          social_platform
  platform_user_id  String?
  username          String
  access_token      String?
  refresh_token     String?
  token_expires_at  DateTime?       @db.Timestamptz(6)
  follower_count    Int?
  subscriber_count  Int?
  total_views       BigInt?
  avg_views_30d     Int?
  avg_viewers       Int?
  avg_viewers_30d   Int?
  engagement_rate   Decimal?        @db.Decimal(5, 4)
  likes_avg         Int?
  stats_json        Json?
  last_fetched_at   DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([target_user_id, platform])
}

model webhook_deliveries {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id   String   @db.Uuid
  event_type   String
  payload      Json
  status_code  Int?
  response     String?
  success      Boolean
  attempt      Int      @default(1)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([webhook_id])
  @@index([created_at])
}

model creator_balance_fills {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id  String
  deal_id         String?  @db.Uuid
  amount          Decimal  @db.Decimal(20, 2)
  status          String   @default("completed") // completed, failed
  triggered_by    String   @default("cron") // cron, manual
  webhook_sent    Boolean  @default(false)
  webhook_error   String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([target_user_id])
  @@index([created_at])
}

enum limit_period_type {
  daily
  weekly
  monthly
}

model admin_balance_limits {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String
  period_type    limit_period_type
  max_amount     Decimal           @db.Decimal(12, 2)
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @default(now()) @db.Timestamptz(6)
  created_by     String?
  updated_by     String?

  @@unique([admin_user_id, period_type])
}

enum admin_role {
  admin
  support
  marketing
  creator
  // Hired-employee role limited to creating new packs. Defaults to
  // /packs only and gets the __can_create_pack +
  // __can_upload_pack_image capabilities; cannot toggle packs live,
  // edit existing packs, or see other admin pages.
  pack_creator
}

enum webhook_type {
  balance_fill
  deal_data
}

enum deal_type {
  flat_fee
  rev_share
  hybrid
  custom
}

enum deal_status {
  pending
  active
  completed
  cancelled
}

enum social_platform {
  twitter
  youtube
  kick
  discord
  instagram
}

model expenses {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description     String
  amount          Decimal          @db.Decimal(20, 2)
  date            DateTime         @db.Date
  paid_to         String
  paid_by         String?
  payment_method  String
  category        String
  notes           String?
  created_by_id   String           @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)

  created_by      admin_users      @relation(fields: [created_by_id], references: [id])

  @@index([date])
  @@index([category])
}

model recurring_expenses {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  amount          Decimal          @db.Decimal(20, 2)
  category        String
  notes           String?
  is_active       Boolean          @default(true)
  created_by_id   String           @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)

  created_by      admin_users      @relation(fields: [created_by_id], references: [id])
}

// Generic key/value store for admin-panel configuration. Used by the Ads
// tracking feature to remember which real user account owns the house
// affiliate codes, and extensible to other one-off global settings
// without spawning a dedicated model per entry.
model admin_settings {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updated_by String?  @db.Uuid
}

// ─── Shift planner ─────────────────────────────────────────────────
// Weekly support-team rota. Each week has up to 3 shifts per day; the
// admin who plans the week sets the concrete start/end instant for each
// shift + tags one or more admin_users as the people on duty. Times
// are stored as absolute UTC Timestamptz so TZ conversion on the client
// is unambiguous — viewers see them in their own preference zone.
model admin_shifts {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Monday 00:00 UTC of the ISO week the shift belongs to. Used as the
  // primary grouping key on reads + for the unique constraint.
  week_start     DateTime                  @db.Timestamptz(6)
  // 0 = Monday … 6 = Sunday (ISO week numbering).
  day_of_week    Int
  // 0, 1, 2 — which of the three daily shift slots this is. Slots are
  // stable across weeks so "slot 0" of this week can be compared to
  // "slot 0" of last week even if the hours changed.
  shift_slot     Int
  // Concrete start / end instants. The pair must fall within the same
  // 24h window rooted at week_start + day_of_week — validated at the
  // action boundary, not via a DB constraint (which would be awkward).
  start_at       DateTime                  @db.Timestamptz(6)
  end_at         DateTime                  @db.Timestamptz(6)
  // Free-form note — "on-call for card withdrawals", "sponsored tourney",
  // etc. Optional.
  notes          String?
  created_by_id  String                    @db.Uuid
  created_by     admin_users               @relation("admin_shifts_created_by", fields: [created_by_id], references: [id])
  assignments    admin_shift_assignments[]
  created_at     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                  @updatedAt @db.Timestamptz(6)

  // One shift per (week, day, slot). Upsert-keyed off this triple.
  @@unique([week_start, day_of_week, shift_slot])
  @@index([week_start])
}

// Many-to-many between shifts and admin_users. Explicit join table (not
// an array column on admin_shifts) so admin user deletion cascades
// cleanly and we keep referential integrity.
model admin_shift_assignments {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shift_id      String       @db.Uuid
  admin_user_id String       @db.Uuid
  shift         admin_shifts @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  admin_user    admin_users  @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([shift_id, admin_user_id])
  @@index([admin_user_id])
}


// ─── Employee salaries (motha-only manual payout register) ────────
// We dropped the on-chain auto-payment system — motha sends USDT
// from their own wallet manually (clicks an employee → QR code of
// the address → scans with their wallet of choice). The DB is now
// just a registry of recipients + a manual log of payments
// recorded after the fact (with optional etherscan tx link).
model salary_employees {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Discord username (`.unique` style or legacy `User#1234`). Stored
  // as plain text — we only use it for display + audit metadata, not
  // for any Discord API auth.
  discord_name     String
  // 0x-prefixed lowercased Ethereum address. Validation happens at
  // the server-action boundary (ethers.isAddress), the column itself
  // is just a String so test addresses / future-other-chain cases
  // don't require a migration.
  eth_address      String
  // Pay frequency. One of "weekly" | "biweekly" | "monthly".
  // Stored as TEXT (no enum) so changing the set of values doesn't
  // require a migration; validated at the action boundary.
  cadence          String              @default("monthly")
  // The employee's recurring salary in USDT (6 decimals). This is the
  // amount paid PER PERIOD (matches the cadence above), not monthly.
  // Monthly equivalent computed at render time.
  salary_usdt      Decimal             @db.Decimal(20, 6)
  // Optional safety cap — refuses any single payout exceeding this
  // amount even if the admin types it explicitly. Catches typos.
  max_per_payout   Decimal?            @db.Decimal(20, 6)
  active           Boolean             @default(true)
  last_paid_at     DateTime?           @db.Timestamptz(6)
  notes            String?
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @updatedAt @db.Timestamptz(6)
  created_by_id    String              @db.Uuid
  created_by       admin_users         @relation(fields: [created_by_id], references: [id])

  payouts          salary_payouts[]

  @@index([active])
}

model salary_payouts {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id     String           @db.Uuid
  amount_usdt     Decimal          @db.Decimal(20, 6)
  // Captured at send time so a later employee.eth_address rename
  // doesn't rewrite history. Always lowercased.
  to_address      String
  // Null until broadcast succeeds. Indexed unique so a retry can't
  // accidentally double-insert the same on-chain transfer.
  tx_hash         String?          @unique
  // pending → broadcast → confirmed (or failed). Status moves
  // forward only.
  status          String           @default("pending")
  error_message   String?
  broadcast_at    DateTime?        @db.Timestamptz(6)
  confirmed_at    DateTime?        @db.Timestamptz(6)
  failed_at       DateTime?        @db.Timestamptz(6)
  paid_by_id      String           @db.Uuid
  paid_by         admin_users      @relation(fields: [paid_by_id], references: [id])
  created_at      DateTime         @default(now()) @db.Timestamptz(6)

  employee        salary_employees @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
}

// ─── Employee org board (drag-and-drop workspace grouping) ─────────
// A Kanban-style board (page /employees, all-admin access) where the
// employees from the salary registry are organized into named
// "workspace" columns and tagged with free-form roles. This board is
// broader-access than the founders-only /salaries page, so it stores
// NOTHING sensitive — pay/wallet data never leaves the salary tables.
// Tables are also created via a runtime IF-NOT-EXISTS fallback in
// src/lib/employee-board/ensure-schema.ts (no migration file, matching
// the salary self-heal pattern).
model employee_workspaces {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Display name of the column ("Marketing", "Dev", …).
  name       String
  // Manual ordering of the columns left-to-right.
  position      Int                           @default(0)
  created_at    DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                      @updatedAt @db.Timestamptz(6)
  placements    employee_board_placements[]
  manager_links employee_manager_workspaces[]
}

// One row per placed employee. employee_id is salary_employees.id but
// intentionally kept as a LOOSE column (DB-level FK only, no Prisma
// relation field on salary_employees) so the salary model stays
// untouched. workspace_id null = the "Unassigned" pool.
model employee_board_placements {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id  String               @unique @db.Uuid
  workspace_id String?              @db.Uuid
  roles        String[]             @default([])
  position     Int                  @default(0)
  created_at   DateTime             @default(now()) @db.Timestamptz(6)
  updated_at   DateTime             @updatedAt @db.Timestamptz(6)
  workspace    employee_workspaces? @relation(fields: [workspace_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
}

// An employee promoted to "manager" — rendered in the row above the
// workspace columns. employee_id is salary_employees.id (loose column,
// DB-level FK only, same convention as employee_board_placements). A
// manager can oversee many workspaces via employee_manager_workspaces.
model employee_managers {
  id          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String                        @unique @db.Uuid
  // Manual ordering of the manager blocks left-to-right.
  position    Int                           @default(0)
  created_at  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                      @updatedAt @db.Timestamptz(6)
  workspaces  employee_manager_workspaces[]
}

// Many-to-many link manager ↔ workspace. One row per connector line on
// the board. Both FKs CASCADE so deleting a manager or a workspace
// removes its lines automatically.
model employee_manager_workspaces {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manager_id   String              @db.Uuid
  workspace_id String              @db.Uuid
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  manager      employee_managers   @relation(fields: [manager_id], references: [id], onDelete: Cascade)
  workspace    employee_workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([manager_id, workspace_id])
  @@index([manager_id])
  @@index([workspace_id])
}

// Admin-side "sponsored %" annotation on a creator (affiliate)
// leaderboard. Purely a cost-accounting input — it does NOT touch the
// backend leaderboard in any way. The /creators "Leaderboard Cost" KPI
// counts each approved leaderboard's prize pool × this percentage;
// leaderboards with no row default to 100% (full cost).
model admin_leaderboard_sponsorship {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg backend affiliate-leaderboard id (uuid string — separate
  // system, can't be an FK). One row per leaderboard; the
  // setLeaderboardSponsorship upsert keys on this.
  leaderboard_id       String   @unique
  // 0–100. Share of this leaderboard's cost the house sponsored.
  // Range is enforced server-side in the action (Zod).
  sponsored_percentage Decimal  @db.Decimal(5, 2)
  // admin_users.id of whoever last set it (plain column — no FK, so
  // adding this table doesn't touch the admin_users model).
  set_by_admin_id      String   @db.Uuid
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
}
