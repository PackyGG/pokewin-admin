// Generic key/value store for admin-panel configuration. Used by the Ads
// tracking feature to remember which real user account owns the house
// affiliate codes, and extensible to other one-off global settings
// without spawning a dedicated model per entry.
model admin_settings {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updated_by String?  @db.Uuid
}

// ─── Shift planner ─────────────────────────────────────────────────
// Weekly support-team rota. Each week has up to 3 shifts per day; the
// admin who plans the week sets the concrete start/end instant for each
// shift + tags one or more admin_users as the people on duty. Times
// are stored as absolute UTC Timestamptz so TZ conversion on the client
// is unambiguous — viewers see them in their own preference zone.
model admin_shifts {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Monday 00:00 UTC of the ISO week the shift belongs to. Used as the
  // primary grouping key on reads + for the unique constraint.
  week_start     DateTime                  @db.Timestamptz(6)
  // 0 = Monday … 6 = Sunday (ISO week numbering).
  day_of_week    Int
  // 0, 1, 2 — which of the three daily shift slots this is. Slots are
  // stable across weeks so "slot 0" of this week can be compared to
  // "slot 0" of last week even if the hours changed.
  shift_slot     Int
  // Concrete start / end instants. The pair must fall within the same
  // 24h window rooted at week_start + day_of_week — validated at the
  // action boundary, not via a DB constraint (which would be awkward).
  start_at       DateTime                  @db.Timestamptz(6)
  end_at         DateTime                  @db.Timestamptz(6)
  // Free-form note — "on-call for card withdrawals", "sponsored tourney",
  // etc. Optional.
  notes          String?
  created_by_id  String                    @db.Uuid
  created_by     admin_users               @relation("admin_shifts_created_by", fields: [created_by_id], references: [id])
  assignments    admin_shift_assignments[]
  created_at     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                  @updatedAt @db.Timestamptz(6)

  // One shift per (week, day, slot). Upsert-keyed off this triple.
  @@unique([week_start, day_of_week, shift_slot])
  @@index([week_start])
}

// Many-to-many between shifts and admin_users. Explicit join table (not
// an array column on admin_shifts) so admin user deletion cascades
// cleanly and we keep referential integrity.
model admin_shift_assignments {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shift_id      String       @db.Uuid
  admin_user_id String       @db.Uuid
  shift         admin_shifts @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  admin_user    admin_users  @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([shift_id, admin_user_id])
  @@index([admin_user_id])
}


// ─── Employee salaries (motha-only manual payout register) ────────
// We dropped the on-chain auto-payment system — motha sends USDT
// from their own wallet manually (clicks an employee → QR code of
// the address → scans with their wallet of choice). The DB is now
// just a registry of recipients + a manual log of payments
// recorded after the fact (with optional etherscan tx link).
model salary_employees {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Discord username (`.unique` style or legacy `User#1234`). Stored
  // as plain text — we only use it for display + audit metadata, not
  // for any Discord API auth.
  discord_name     String
  // 0x-prefixed lowercased Ethereum address. Validation happens at
  // the server-action boundary (ethers.isAddress), the column itself
  // is just a String so test addresses / future-other-chain cases
  // don't require a migration.
  eth_address      String
  // Pay frequency. One of "weekly" | "biweekly" | "monthly".
  // Stored as TEXT (no enum) so changing the set of values doesn't
  // require a migration; validated at the action boundary.
  cadence          String              @default("monthly")
  // The employee's recurring salary in USDT (6 decimals). This is the
  // amount paid PER PERIOD (matches the cadence above), not monthly.
  // Monthly equivalent computed at render time.
  salary_usdt      Decimal             @db.Decimal(20, 6)
  // Optional safety cap — refuses any single payout exceeding this
  // amount even if the admin types it explicitly. Catches typos.
  max_per_payout   Decimal?            @db.Decimal(20, 6)
  active           Boolean             @default(true)
  // Legacy weekday pay day (0=Sun…6=Sat). Superseded by
  // pay_day_of_month; kept for back-compat, not used by the UI.
  pay_day_of_week  Int?                @db.SmallInt
  // Recurring pay day as a day of the month (1-31, clamped to the
  // month's length at render). Null = none set.
  pay_day_of_month Int?                @db.SmallInt
  last_paid_at     DateTime?           @db.Timestamptz(6)
  notes            String?
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @updatedAt @db.Timestamptz(6)
  created_by_id    String              @db.Uuid
  created_by       admin_users         @relation(fields: [created_by_id], references: [id])

  payouts          salary_payouts[]
  payments         salary_payments[]

  @@index([active])
}

model salary_payouts {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id     String           @db.Uuid
  amount_usdt     Decimal          @db.Decimal(20, 6)
  // Captured at send time so a later employee.eth_address rename
  // doesn't rewrite history. Always lowercased.
  to_address      String
  // Null until broadcast succeeds. Indexed unique so a retry can't
  // accidentally double-insert the same on-chain transfer.
  tx_hash         String?          @unique
  // pending → broadcast → confirmed (or failed). Status moves
  // forward only.
  status          String           @default("pending")
  error_message   String?
  broadcast_at    DateTime?        @db.Timestamptz(6)
  confirmed_at    DateTime?        @db.Timestamptz(6)
  failed_at       DateTime?        @db.Timestamptz(6)
  paid_by_id      String           @db.Uuid
  paid_by         admin_users      @relation(fields: [paid_by_id], references: [id])
  created_at      DateTime         @default(now()) @db.Timestamptz(6)

  employee        salary_employees @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
}

// Lightweight payment tracking — a saved payment link + date per
// employee. Distinct from the legacy salary_payouts table; this is just
// "who was paid, the link, and when". created_by_id is a loose FK to
// admin_users (DB-level only, no Prisma relation) to keep the admin_users
// model untouched.
model salary_payments {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id   String           @db.Uuid
  payment_link  String
  paid_at       DateTime         @default(now()) @db.Timestamptz(6)
  created_by_id String           @db.Uuid
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  employee      salary_employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@index([paid_at(sort: Desc)])
}

// ─── Employee org board (drag-and-drop workspace grouping) ─────────
// A Kanban-style board (page /employees, all-admin access) where the
// employees from the salary registry are organized into named
// "workspace" columns and tagged with free-form roles. This board is
// broader-access than the founders-only /salaries page, so it stores
// NOTHING sensitive — pay/wallet data never leaves the salary tables.
// Tables are also created via a runtime IF-NOT-EXISTS fallback in
// src/lib/employee-board/ensure-schema.ts (no migration file, matching
// the salary self-heal pattern).
model employee_workspaces {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Display name of the column ("Marketing", "Dev", …).
  name       String
  // Manual ordering of the columns left-to-right.
  position      Int                           @default(0)
  created_at    DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                      @updatedAt @db.Timestamptz(6)
  placements    employee_board_placements[]
  manager_links employee_manager_workspaces[]
}

// One row per (employee, workspace) placement — an employee can be
// placed in multiple sections (someone who handles both areas). Roles
// are per-placement, so the same person can hold different roles in
// different sections. employee_id is salary_employees.id but
// intentionally kept as a LOOSE column (DB-level FK only, no Prisma
// relation field on salary_employees) so the salary model stays
// untouched. workspace_id null = legacy roles-only "Unassigned" row
// (older rows created when an employee had roles but no section);
// new rows created by the multi-section UI always carry a workspace.
model employee_board_placements {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id  String               @db.Uuid
  workspace_id String?              @db.Uuid
  roles        String[]             @default([])
  position     Int                  @default(0)
  created_at   DateTime             @default(now()) @db.Timestamptz(6)
  updated_at   DateTime             @updatedAt @db.Timestamptz(6)
  workspace    employee_workspaces? @relation(fields: [workspace_id], references: [id], onDelete: SetNull)

  // An employee can be placed in any given workspace at most once.
  // Postgres treats NULL workspace_id rows as distinct under unique
  // constraints, so legacy roles-only Unassigned rows are not blocked.
  @@unique([employee_id, workspace_id])
  @@index([workspace_id])
  @@index([employee_id])
}

// An employee promoted to "manager" — rendered in the row above the
// workspace columns. employee_id is salary_employees.id (loose column,
// DB-level FK only, same convention as employee_board_placements). A
// manager can oversee many workspaces via employee_manager_workspaces.
model employee_managers {
  id          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String                        @unique @db.Uuid
  // Manual ordering of the manager blocks left-to-right.
  position    Int                           @default(0)
  created_at  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                      @updatedAt @db.Timestamptz(6)
  workspaces  employee_manager_workspaces[]
}

// Many-to-many link manager ↔ workspace. One row per connector line on
// the board. Both FKs CASCADE so deleting a manager or a workspace
// removes its lines automatically.
model employee_manager_workspaces {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manager_id   String              @db.Uuid
  workspace_id String              @db.Uuid
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  manager      employee_managers   @relation(fields: [manager_id], references: [id], onDelete: Cascade)
  workspace    employee_workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([manager_id, workspace_id])
  @@index([manager_id])
  @@index([workspace_id])
}

// 7-day soft-delete snapshot for main-DB users wiped via the admin
// /users delete action. When an admin clicks Delete User on /users/[id]
// (or bulk-deletes from /users), the deleteUser server action snapshots
// the user row plus the heavier per-user satellite tables (balances,
// inventory, vouchers, rakeback claims, recent ledger / game sessions)
// into this table BEFORE running the destructive main-DB delete. The
// snapshot lives here for 7 days — listed at /users/deleted — and can
// be restored or purged manually. After expires_at the row is purged
// fire-and-forget on the next /users/deleted read.
//
// Storage notes:
//   • id IS the original main-DB user.id (text — better-auth nanoid).
//     A user can only have one active snapshot at a time; re-deleting
//     a user after restore would overwrite the prior row (upsert).
//   • snapshot is the JSONB blob — see src/lib/deleted-users/snapshot.ts
//     for the shape. Bounded to ~5 MB; over-large arrays are truncated
//     with a _truncated marker logged inside the blob.
//   • Cross-DB FKs aren't possible (main DB vs admin DB live on
//     separate Postgres clusters) — deleted_by / restored_by are plain
//     UUIDs that match admin_users.id. We don't relation-link them
//     here either, to keep admin_users untouched.
model admin_deleted_users {
  // Original packy.gg user_id (text — better-auth nanoid).
  id           String    @id @db.VarChar(36)
  // Captured at delete time so the listing UI doesn't need to crack the
  // JSONB blob to render usernames/emails.
  username     String?   @db.VarChar(255)
  email        String?   @db.VarChar(255)
  deleted_at   DateTime  @default(now()) @db.Timestamp(6)
  // admin_users.id of whoever ran the delete. Plain UUID column — no
  // Prisma relation so adding this table doesn't touch admin_users.
  deleted_by   String    @db.VarChar(36)
  // deleted_at + 7 days. Set server-side at insert; listing reads
  // expire-and-purge before rendering. Indexed for the purge scan.
  expires_at   DateTime  @db.Timestamp(6)
  // JSONB blob — { user, balances, user_inventory, vouchers,
  // rakeback_claims, ledger_transactions, game_sessions, _truncated }
  snapshot     Json      @db.JsonB
  // Null until restoreDeletedUser runs. Once set, the snapshot is
  // immutable and cannot be restored again — re-restoring would
  // double-insert. Restored snapshots stay listed (with the restore
  // status visible) until natural expiry.
  restored_at  DateTime? @db.Timestamp(6)
  restored_by  String?   @db.VarChar(36)

  @@index([expires_at], map: "admin_deleted_users_expires_at_idx")
  @@index([deleted_at(sort: Desc)], map: "admin_deleted_users_deleted_at_idx")
}

// Recoverable snapshot of "content" balance-adjustment ledger rows that an
// admin wiped off a user's account via the /users/[id] "Wipe content
// balance adjustments" flow. The owner hands creators admin balance
// adjustments so they can make content (open packs / stream); this lets
// those be cleaned out of a user's account WITHOUT touching real financial
// or gaming history. Hard-delete is the chosen mechanism, so the deleted
// rows are snapshotted here first to keep the operation recoverable.
//
//   • id is the wipe-BATCH id (one row per wipe action, may cover several
//     deleted ledger rows). gen_random_uuid() like every other admin table.
//   • user_id is the main-DB packy.gg user id (better-auth nanoid, text).
//     NOT a Prisma relation — main DB vs admin DB live on separate Postgres
//     clusters, so cross-DB FKs aren't possible. user_id / wiped_by /
//     restored_by are plain text/UUID columns that match the respective
//     ids in their own DBs.
//   • snapshot is the JSONB blob: { userId, rows: ledger_transactions[] }
//     where each row is the full deleted ledger_transactions row with
//     Decimal/Date values serialized to canonical strings — see
//     src/lib/balance-adjustment-wipes/snapshot.ts. Restore re-inserts the
//     rows verbatim and re-adds the summed amount back to the balance.
//   • total_amount is the SUM of the deleted rows' amounts (signed). The
//     wipe REDUCES balances.available_balance by exactly this, so restore
//     ADDS it back. balance_before / balance_after capture the user's
//     available_balance immediately around the wipe for the audit trail.
//   • restored_at is null until restoreBalanceAdjustmentWipe runs. Once
//     set the batch can't be restored again (re-restoring would
//     double-insert + double-credit). Restored batches stay listed with
//     the restore status visible.
//
// Provisioned at runtime via the IF-NOT-EXISTS ensure-schema fallback
// (src/lib/balance-adjustment-wipes/ensure-schema.ts) — NOT a Prisma
// migration, because the admin DB has a drifted migration history. This
// model only mirrors the table so typed queries via
// `adminDb.admin_balance_adjustment_wipes.*` work; keep the two in sync.
model admin_balance_adjustment_wipes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Main-DB user the adjustments were wiped from (better-auth nanoid).
  user_id          String    @db.VarChar(36)
  // Captured at wipe time so the listing UI doesn't have to crack the JSONB.
  username         String?   @db.VarChar(255)
  email            String?   @db.VarChar(255)
  wiped_at         DateTime  @default(now()) @db.Timestamp(6)
  // admin_users.id of whoever ran the wipe. Plain UUID column — no Prisma
  // relation so adding this table doesn't touch admin_users.
  wiped_by         String    @db.VarChar(36)
  // SUM of the deleted rows' signed amounts. The wipe subtracts this from
  // available_balance; restore adds it back. Decimal(20,2) matches the
  // ledger / balance precision.
  total_amount     Decimal   @db.Decimal(20, 2)
  // User's available_balance immediately before / after the wipe.
  balance_before   Decimal   @db.Decimal(20, 2)
  balance_after    Decimal   @db.Decimal(20, 2)
  // How many ledger rows this batch deleted.
  adjustment_count Int
  // JSONB blob — { userId, rows: ledger_transactions[] }. Each row is the
  // full deleted ledger_transactions row, Decimal/Date → canonical string.
  snapshot         Json      @db.JsonB
  // Lifecycle status (dual-DB audit consistency) — same semantics as
  // admin_account_wipes.status. DEFAULT 'completed' back-fills existing rows.
  status           String    @default("completed") @db.VarChar(16)
  // Null until restoreBalanceAdjustmentWipe runs. Once set the batch is
  // immutable + cannot be re-restored.
  restored_at      DateTime? @db.Timestamp(6)
  restored_by      String?   @db.VarChar(36)

  @@index([user_id], map: "admin_balance_adjustment_wipes_user_id_idx")
  @@index([wiped_at(sort: Desc)], map: "admin_balance_adjustment_wipes_wiped_at_idx")
}

// Generalized recovery store for the three NEW account-wipe targets —
// "balance" (zero available_balance), "vault" (zero locked_balance +
// unlock_at), "inventory" (delete user_inventory rows). One table keyed by
// `wipe_type`; the type-specific recovery payload lives in `snapshot`.
//
// Snapshot-FIRST + recoverable, mirroring commit f4bfca0 (the adjustments
// wipe above): the snapshot is written here BEFORE the destructive main-DB
// write, so a wipe is always restorable; once the destructive tx commits it
// is permanent. Restore re-applies the snapshot (re-credit balance /
// re-credit vault / re-insert inventory) and marks restored_at.
//
// Provisioned at runtime via the IF-NOT-EXISTS ensure-schema fallback
// (src/lib/account-wipes/ensure-schema.ts) — NOT a Prisma migration,
// because the admin DB has a drifted migration history. This model only
// mirrors the table so typed queries via `adminDb.admin_account_wipes.*`
// work; keep the two in sync.
model admin_account_wipes {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 'balance' | 'vault' | 'inventory' (AccountWipeType).
  wipe_type   String    @db.VarChar(32)
  // Main-DB user the wipe acted on (better-auth nanoid).
  user_id     String    @db.VarChar(36)
  // Captured at wipe time so the listing UI doesn't have to crack the JSONB.
  username    String?   @db.VarChar(255)
  email       String?   @db.VarChar(255)
  wiped_at    DateTime  @default(now()) @db.Timestamp(6)
  // admin_users.id of whoever ran the wipe. Plain column — no Prisma
  // relation so adding this table doesn't touch admin_users.
  wiped_by    String    @db.VarChar(36)
  // Money removed (balance/vault wipes). 0 for an inventory wipe.
  amount      Decimal   @default(0) @db.Decimal(20, 2)
  // Rows removed (inventory wipe). 0 for a balance/vault wipe.
  item_count  Int       @default(0)
  // JSONB recovery payload — shape depends on wipe_type (see
  // src/lib/account-wipes/snapshot.ts). Decimal/Date → canonical string.
  snapshot    Json      @db.JsonB
  // Lifecycle status (dual-DB audit consistency). 'pending' = snapshot
  // written, finalize not yet confirmed; 'completed' = main-DB delete
  // committed AND (atomically in the admin DB) status flipped + audit row
  // written; 'failed' = main-DB delete failed, snapshot kept as a terminal
  // marker (restore refuses it). DEFAULT 'completed' back-fills existing rows.
  // See src/lib/account-wipes/ensure-schema.ts + finalize.ts.
  status      String    @default("completed") @db.VarChar(16)
  // Null until the matching restore runs. Once set the wipe is immutable +
  // cannot be re-restored.
  restored_at DateTime? @db.Timestamp(6)
  restored_by String?   @db.VarChar(36)

  @@index([user_id], map: "admin_account_wipes_user_id_idx")
  @@index([wiped_at(sort: Desc)], map: "admin_account_wipes_wiped_at_idx")
}

// Rich, admin-only metadata for a STRICT categorized balance adjustment.
//
// The canonical CATEGORY KEY also lives on the MAIN-DB ledger row
// (`metadata.adjustment_category`) — that is what the GGR/NGR/cost queries
// read with NO cross-DB join. THIS table is the audit/detail companion: it
// holds the category-specific inputs (coin type + tx hash, social link,
// exact bonus reason, lossback % + 7d PnL + note) that only make sense in
// the admin panel and never need to be in the main DB. It powers the
// /insights/balance-adjustments detail/audit views.
//
// Provisioned at runtime via the IF-NOT-EXISTS ensure-schema fallback
// (src/lib/balance-adjustment-meta/ensure-schema.ts) — NOT a Prisma
// migration, because the admin DB has a drifted migration history. This
// model only mirrors the table so typed queries via
// `adminDb.admin_balance_adjustment_meta.*` work; keep the two in sync.
model admin_balance_adjustment_meta {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // admin_users.id of whoever made the adjustment. Plain column — no Prisma
  // relation so adding this table doesn't touch admin_users.
  admin_user_id  String   @db.VarChar(36)
  // Main-DB user the balance landed on (better-auth nanoid).
  target_user_id String   @db.VarChar(36)
  // Main-DB ledger_transactions row id this metadata describes. Loose
  // cross-DB reference (separate Postgres — can't be a real FK).
  ledger_tx_id   String   @db.VarChar(36)
  // Canonical category key (BalanceAdjustmentCategory) — also stamped onto
  // the ledger row's metadata. One of:
  // deposit_problem | giveaway | bonus | reload | lossback | other.
  category       String   @db.VarChar(40)
  // Signed USD amount that landed on the user (mirrors the ledger amount)
  // so the detail view doesn't need a cross-DB lookup.
  amount_usd     Decimal  @db.Decimal(20, 2)
  // deposit_problem: the coin + on-chain tx hash that was under-credited.
  coin_type      String?  @db.VarChar(64)
  tx_hash        String?  @db.VarChar(255)
  // giveaway: the Twitter / Discord link the giveaway was sourced from.
  social_link    String?  @db.VarChar(2048)
  // bonus: exact reason (≥20 chars). lossback: optional free-text note.
  reason_text    String?
  // lossback: the % of recent losses credited back.
  lossback_pct   Decimal? @db.Decimal(7, 2)
  // lossback: the user's 7-day PnL value the % was applied against.
  pnl_7d_usd     Decimal? @db.Decimal(20, 2)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@index([target_user_id], map: "admin_balance_adjustment_meta_target_user_id_idx")
  @@index([created_at(sort: Desc)], map: "admin_balance_adjustment_meta_created_at_idx")
  @@index([ledger_tx_id], map: "admin_balance_adjustment_meta_ledger_tx_id_idx")
  @@index([category], map: "admin_balance_adjustment_meta_category_idx")
}

// Admin-side "sponsored %" annotation on a creator (affiliate)
// leaderboard. Purely a cost-accounting input — it does NOT touch the
// backend leaderboard in any way. The /creators "Leaderboard Cost" KPI
// counts each approved leaderboard's prize pool × this percentage;
// leaderboards with no row default to 100% (full cost).
model admin_leaderboard_sponsorship {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg backend affiliate-leaderboard id (uuid string — separate
  // system, can't be an FK). One row per leaderboard; the
  // setLeaderboardSponsorship upsert keys on this.
  leaderboard_id       String   @unique
  // 0–100. Share of this leaderboard's cost the house sponsored.
  // Range is enforced server-side in the action (Zod).
  sponsored_percentage Decimal  @db.Decimal(5, 2)
  // admin_users.id of whoever last set it (plain column — no FK, so
  // adding this table doesn't touch the admin_users model).
  set_by_admin_id      String   @db.Uuid
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
}

// ─── Leaderboard "creator paid his part" flag ──────────────────────
// Admin-side internal tracking flag on a creator (affiliate)
// leaderboard: did the creator actually pay their off-site share?
// Purely a "so we know if he paid or not" annotation — it does NOT
// touch the backend leaderboard, any balance/ledger, or ANY money
// math (PnL / GGR / Leaderboard Cost are unaffected). A dedicated
// table (not a column on admin_leaderboard_sponsorship) so the toggle
// works even for leaderboards that have no sponsorship row yet.
// One row per leaderboard; the setLeaderboardCreatorPaid upsert keys
// on the unique leaderboard_id.
model admin_leaderboard_creator_paid {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg backend affiliate-leaderboard id (uuid string — separate
  // system, can't be an FK). One row per leaderboard.
  leaderboard_id  String    @unique
  // Whether the creator has paid their part. Default false.
  paid            Boolean   @default(false)
  // When `paid` was last flipped to true (cleared back to null when
  // toggled off). Set server-side in the action.
  paid_at         DateTime? @db.Timestamptz(6)
  // admin_users.id of whoever last set it (plain column — no FK, so
  // adding this table doesn't touch the admin_users model).
  set_by_admin_id String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
}

// ─── Changelog entries (admin-panel release notes) ─────────────────
// Curated release notes surfaced at /changelogs. Each row is one self-
// contained "what changed in this release" card. Storage is admin-DB
// only because this is operational/internal content — never shown to
// end users on packy.gg, only to admins inside the panel. The page is
// public-read to anyone with `/changelogs` access; write requires an
// admin role + the `__can_manage_changelog` capability.
//
// Provisioned at runtime via the IF-NOT-EXISTS fallback in
// src/lib/changelog/ensure-schema.ts — there is deliberately NO
// migration file (same convention as employee_workspaces and the
// salary tables, see ensure-schema.ts comment for context on the
// drifted admin-DB migration history).
//
// Fields:
//   • published_at — admin-set "release date" (NOT row-created-at).
//     Lets the same release be backdated or scheduled by hand.
//   • title — short label ("Sets overhaul", "Treasury tile"),
//     rendered as the card headline.
//   • summary — one-paragraph TL;DR. Plain text (markdown-safe but
//     not rendered as markdown — no XSS surface).
//   • version — optional human label ("v2025.11", "Sprint 23").
//   • category — drives the badge color/icon on the card. One of
//     'feature' | 'fix' | 'improvement' | 'breaking' | 'infra'.
//     Enforced server-side via Zod; the column is plain TEXT so a
//     future category doesn't require a DB migration.
//   • changes — array of `{ kind, text }` rows ({ kind: 'feature' |
//     'fix' | 'improvement' | 'breaking' | 'infra', text: string }).
//     Rendered as a per-row bullet list inside the card with a small
//     icon per kind.
//   • author_admin_user_id — who published the entry. Plain UUID
//     column (no Prisma relation to admin_users) to keep the
//     admin_users model untouched, matching the convention used by
//     employee_managers / salary_payments / admin_leaderboard_sponsorship.
model admin_changelog_entries {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  published_at          DateTime @db.Timestamptz(6)
  title                 String
  summary               String
  version               String?
  // Bucketed category — drives badge color + icon on the card.
  category              String
  // jsonb array of { kind: 'feature'|'fix'|'improvement'|'breaking'|'infra',
  // text: string }. Shape validated at the server-action boundary.
  changes               Json     @db.JsonB
  // Loose FK to admin_users.id — no Prisma relation here so adding
  // this table doesn't perturb the admin_users model. Nullable so
  // entries authored by a deleted admin still render.
  author_admin_user_id  String?  @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt        @db.Timestamptz(6)

  @@index([published_at(sort: Desc)], map: "admin_changelog_entries_published_at_idx")
}
