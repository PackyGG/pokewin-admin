generator client {
  provider = "prisma-client"
  output   = "../../src/generated/admin-prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_users {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String               @unique
  username       String               @unique
  password_hash  String
  role           admin_role           @default(admin)
  // Optional FK to admin_roles. Nullable so existing users keep working on
  // the hardcoded `role` enum during transition. Once a role_id is set it
  // takes precedence over the enum-based system-role defaults.
  role_id        String?              @db.Uuid
  custom_role    admin_roles?         @relation(fields: [role_id], references: [id], onDelete: SetNull)
  totp_secret    String?
  totp_enabled   Boolean              @default(false)
  recovery_codes String[]
  is_active      Boolean              @default(true)
  // Profile fields (editable by the admin themselves on /profile).
  // display_username: label shown in the header/UI; falls back to `username` when null.
  // profile_image / profile_image_mime: raw avatar bytes + MIME stored directly in DB.
  display_username   String?
  profile_image      Bytes?
  profile_image_mime String?
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @updatedAt @db.Timestamptz(6)
  audit_events          admin_audit_events[]
  sessions              admin_sessions[]
  notes                 admin_notes[]
  allowed_pages         String[]
  gift_card_actions     admin_gift_card_actions[]
  voucher_actions       admin_voucher_actions[]
  expenses              expenses[]
  recurring_expenses    recurring_expenses[]
}

// Custom role definitions for the granular-permissions system. Four
// `is_system = true` rows (admin, support, marketing, creator) are seeded
// by prisma/admin/seed.ts and map to the hardcoded admin_role enum values.
// Additional rows created through the admin UI carry `is_system = false`
// and can be freely edited / deleted.
//
// `capabilities` is a string[] of keys from src/lib/permissions.ts
// (CapabilityKey). Both page access (`pages.*`) and action capabilities
// (`domain.action`) live in this single array.
model admin_roles {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique
  description  String?
  is_system    Boolean       @default(false)
  capabilities String[]      @default([])
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @updatedAt        @db.Timestamptz(6)
  admin_users  admin_users[]
}

model admin_sessions {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  ip             String?
  user_agent     String?
  auth_method    String?
  logged_in_at   DateTime    @default(now()) @db.Timestamptz(6)
  expires_at     DateTime    @db.Timestamptz(6)
  logged_out_at  DateTime?   @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])
}

model admin_notes {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  target_user_id String
  content        String
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])
}

model admin_audit_events {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String?      @db.Uuid
  event_type     String
  target_user_id String?
  ip             String?
  metadata       Json?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  admin_user     admin_users? @relation(fields: [admin_user_id], references: [id])
}

model admin_gift_card_actions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gift_card_id     String    @db.Uuid
  action           String    // "created" | "cancelled"
  admin_user_id    String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  admin_user       admin_users @relation(fields: [admin_user_id], references: [id])

  @@index([gift_card_id])
}

model admin_voucher_actions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucher_id       String    @db.Uuid
  action           String    // "created"
  admin_user_id    String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  admin_user       admin_users @relation(fields: [admin_user_id], references: [id])

  @@index([voucher_id])
}

model creator_webhooks {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id  String
  url             String
  secret          String
  type            webhook_type
  enabled         Boolean      @default(true)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([target_user_id])
}

model creator_deals {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id        String
  deal_name             String?
  deal_type             deal_type
  amount                Decimal     @db.Decimal(20, 2)
  currency              String      @default("USD") @db.VarChar(10)
  start_date            DateTime    @db.Timestamptz(6)
  end_date              DateTime?   @db.Timestamptz(6)
  status                deal_status @default(active)
  notes                 String?
  // Balance fill settings
  daily_fill_amount     Decimal?    @db.Decimal(20, 2)
  daily_fill_time       String?     @db.VarChar(5) // "HH:MM" UTC
  daily_fill_enabled    Boolean     @default(false)
  keep_percentage       Decimal?    @db.Decimal(5, 4) // e.g. 0.2000 = 20%
  // Withdrawal limits (synced to creator_withdrawal_limits on main DB)
  currency_limit_amount   Decimal?  @db.Decimal(20, 2)
  currency_limit_reset_days Int?
  percentage_limit        Decimal?  @db.Decimal(5, 4)
  tip_limit               Decimal?  @db.Decimal(20, 2)
  tip_limit_reset_days    Int?
  // Leaderboard
  leaderboard_prize_pool  Decimal?  @db.Decimal(20, 2)
  leaderboard_our_share   Decimal?  @db.Decimal(5, 4) // e.g. 0.5000 = 50%
  leaderboard_frequency   String?   @db.VarChar(20) // "weekly", "biweekly", "monthly"
  // Stream requirements
  min_stream_minutes    Int?
  // Computed/manual risk
  max_financial_exposure Decimal?   @db.Decimal(20, 2)
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime    @default(now()) @db.Timestamptz(6)

  @@index([target_user_id])
}

model creator_socials {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id    String
  platform          social_platform
  platform_user_id  String?
  username          String
  access_token      String?
  refresh_token     String?
  token_expires_at  DateTime?       @db.Timestamptz(6)
  follower_count    Int?
  subscriber_count  Int?
  total_views       BigInt?
  avg_views_30d     Int?
  avg_viewers       Int?
  avg_viewers_30d   Int?
  engagement_rate   Decimal?        @db.Decimal(5, 4)
  likes_avg         Int?
  stats_json        Json?
  last_fetched_at   DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([target_user_id, platform])
}

model webhook_deliveries {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id   String   @db.Uuid
  event_type   String
  payload      Json
  status_code  Int?
  response     String?
  success      Boolean
  attempt      Int      @default(1)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([webhook_id])
  @@index([created_at])
}

model creator_balance_fills {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_user_id  String
  deal_id         String?  @db.Uuid
  amount          Decimal  @db.Decimal(20, 2)
  status          String   @default("completed") // completed, failed
  triggered_by    String   @default("cron") // cron, manual
  webhook_sent    Boolean  @default(false)
  webhook_error   String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([target_user_id])
  @@index([created_at])
}

enum limit_period_type {
  daily
  weekly
  monthly
}

model admin_balance_limits {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String
  period_type    limit_period_type
  max_amount     Decimal           @db.Decimal(12, 2)
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @default(now()) @db.Timestamptz(6)
  created_by     String?
  updated_by     String?

  @@unique([admin_user_id, period_type])
}

enum admin_role {
  admin
  support
  marketing
  creator
}

enum webhook_type {
  balance_fill
  deal_data
}

enum deal_type {
  flat_fee
  rev_share
  hybrid
  custom
}

enum deal_status {
  pending
  active
  completed
  cancelled
}

enum social_platform {
  twitter
  youtube
  kick
  discord
  instagram
}

model expenses {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description     String
  amount          Decimal          @db.Decimal(20, 2)
  date            DateTime         @db.Date
  paid_to         String
  paid_by         String?
  payment_method  String
  category        String
  notes           String?
  created_by_id   String           @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)

  created_by      admin_users      @relation(fields: [created_by_id], references: [id])

  @@index([date])
  @@index([category])
}

model recurring_expenses {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  amount          Decimal          @db.Decimal(20, 2)
  category        String
  notes           String?
  is_active       Boolean          @default(true)
  created_by_id   String           @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)

  created_by      admin_users      @relation(fields: [created_by_id], references: [id])
}

// Generic key/value store for admin-panel configuration. Used by the Ads
// tracking feature to remember which real user account owns the house
// affiliate codes, and extensible to other one-off global settings
// without spawning a dedicated model per entry.
model admin_settings {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updated_by String?  @db.Uuid
}

