generator client {
  provider = "prisma-client"
  output   = "../../src/generated/admin-prisma"
}

datasource db {
  provider = "postgresql"
}

model admin_users {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String               @unique
  username       String               @unique
  password_hash  String
  // Primary / canonical system role. Kept as the single authoritative
  // field for backward-compat: every legacy code path that reads a
  // singular `role` keeps working. When `roles` (below) is non-empty the
  // effective role set is `roles`; `role` is then the highest-privilege
  // member of that set (admin first) so a multi-role user still has a
  // sensible singular role for the places that need one (sidebar landing,
  // creator-portal detection, the db-env admin gate).
  role           admin_role           @default(admin)
  // Additive multi-role support. A user can hold several system roles at
  // once (e.g. support + pack_creator). Effective permissions are the
  // UNION across every role in this array PLUS the per-user adjustments in
  // `allowed_pages`. Empty array = legacy single-role user → treated as
  // `[role]` everywhere (see getEffectiveRoles in src/lib/admin-roles.ts).
  // `role` is always kept in sync as the primary member of this set.
  roles          admin_role[]         @default([])
  // Optional FK to admin_roles. Nullable so existing users keep working on
  // the hardcoded `role` enum during transition. Once a role_id is set it
  // takes precedence over the enum-based system-role defaults.
  role_id        String?              @db.Uuid
  custom_role    admin_roles?         @relation(fields: [role_id], references: [id], onDelete: SetNull)
  totp_secret    String?
  totp_enabled   Boolean              @default(false)
  recovery_codes String[]
  is_active      Boolean              @default(true)
  // OWNER / ULTRA-ADMIN flag (orthogonal to the role/permission model). An
  // owner bypasses EVERY page + capability check (like the `admin` role) AND
  // the owner-only surfaces (Salaries, Excluded Users, the re-price tool,
  // creator-hub-access toggles, admin balance-adjustment visibility, …). The
  // permanent ROOT owner `motha` is owner via a hard-coded bypass in
  // src/lib/owners.ts and is NOT driven by this column, so motha stays owner
  // even if this row reads false. Only the main owner (motha) can toggle this
  // for other admins (see admin-users/[id]/owner-actions.ts). Read DB-fresh in
  // verifySession (NOT baked into the JWT) and surfaced as `session.isOwner`,
  // same pattern as `role`/`is_active`. Additive + default false (every
  // existing row → non-owner). The owner helpers P2022-degrade to false if this
  // column ships ahead of code on some deploy.
  is_owner       Boolean              @default(false)
  // Session-revocation watermark (Phase D safety guards — see
  // ROLE_REDESIGN_DESIGN.md §D). When set, every admin_session JWT this user
  // holds whose `iat` (issued-at, seconds) is BEFORE this instant is treated
  // as revoked by `verifySession` (src/lib/dal.ts) — the gate redirects to
  // /login. Stamped to `now()` by the force-expire-sessions action so a
  // logged-out / compromised admin's existing 12h tokens die immediately.
  // Nullable + default NULL = no revocation (the state of every row today), so
  // this is fully behavior-preserving until an admin force-expires someone.
  // NOTE: the column already exists in the ADMIN DB (applied + verified, all 17
  // rows = NULL); this schema delta only teaches the Prisma client about it —
  // do NOT `prisma db push` / `migrate` (would risk dropping un-modeled drift).
  sessions_valid_after DateTime?       @db.Timestamptz()
  // Profile fields (editable by the admin themselves on /profile).
  // display_username: label shown in the header/UI; falls back to `username` when null.
  // profile_image / profile_image_mime: raw avatar bytes + MIME stored directly in DB.
  display_username   String?
  profile_image      Bytes?
  profile_image_mime String?
  // Per-user preferences (theme, timezone, date format, etc.). See
  // src/lib/admin-preferences.ts for the typed shape. JSONB so we can
  // add new preference slots without a migration per field.
  preferences        Json?                @db.JsonB
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @updatedAt @db.Timestamptz(6)
  audit_events          admin_audit_events[]
  sessions              admin_sessions[]
  notes                 admin_notes[]
  // The materialized runtime permission cache the gate reads
  // (getUserPermissions in src/lib/dal.ts) — page routes ("/users") AND
  // `__can_*` capability flags. Stays the single source of truth every gate
  // consumes; every editor save re-materializes it via the ONE canonical
  // writer (computeEffectivePermissions, src/lib/permissions/materialize.ts).
  allowed_pages         String[]
  // Per-user override layer (Phase C of the role/permission rebuild — see
  // ROLE_REDESIGN_DESIGN.md). Additive, behavior-preserving: both default to
  // the empty array, so a user with no overrides materializes to exactly
  // their role baseline. `permission_grants` adds tokens ON TOP of the role
  // baseline; `permission_revokes` removes tokens (a revoke wins over a
  // baseline/grant for the same token). These columns are the EDITABLE source
  // — `allowed_pages` is the derived runtime cache re-materialized from them.
  // NOTE: the columns already exist in the ADMIN DB (applied + verified, all
  // rows = '{}'); this schema delta only teaches the Prisma client about them
  // — do NOT `prisma db push` / `migrate` (would risk dropping un-modeled drift).
  permission_grants     String[]                 @default([])
  permission_revokes    String[]                 @default([])
  gift_card_actions     admin_gift_card_actions[]
  voucher_actions       admin_voucher_actions[]
  expenses              expenses[]
  recurring_expenses    recurring_expenses[]
  shifts_created        admin_shifts[]              @relation("admin_shifts_created_by")
  shift_assignments     admin_shift_assignments[]
  salary_employees      salary_employees[]
  salary_payouts        salary_payouts[]
  excluded_users         excluded_users[]
  excluded_user_balances_v2 admin_excluded_user_balance_v2[]
  giveaway_actions       admin_giveaway_actions[]
  user_tags              admin_user_tags[]
  passkeys               admin_passkeys[]
  withdrawal_unlocks     admin_withdrawal_unlocks[]
}

/// Per-user withdrawal UNLOCK override.
///
/// Withdrawal-lock policy: every user on the `excluded_users` blacklist is
/// withdrawal-LOCKED BY DEFAULT — their withdrawals cannot be processed,
/// cancelled, shipped, completed, or failed through the admin panel (the
/// withdrawal server actions call `assertWithdrawalNotLocked` first). The
/// PRESENCE of a row here is a per-user UNLOCK override that ONLY the root
/// owner (motha) can grant, re-enabling withdrawal actions for that single
/// user. Absence of a row = locked (when the user is on the blacklist).
///
/// Notes:
///   • `target_user_id` is the packy.gg user_id (better-auth nanoid, text) —
///     the main DB lives in a separate cluster, so no cross-DB FK. It is NOT
///     relation-linked to `excluded_users`: the unlock override can outlive an
///     add/remove of the blacklist entry, and only takes effect while the user
///     is actually excluded.
///   • Primary key IS `target_user_id` — one unlock override per user.
///   • `unlocked_by` references admin_users.id so the UI can show who granted
///     the unlock. NULLABLE + ON DELETE SET NULL so deleting that admin keeps
///     the override (provenance is secondary to the flag).
///
/// Runtime caveat: provisioned via `prisma db execute` of
/// prisma/admin/sql/2026-07-01_add_withdrawal_unlocks.up.sql (the admin DB has
/// drifted migration history — never `migrate deploy`). Runtime reads MUST
/// fail-safe: a missing table degrades to "no unlock override" (excluded users
/// stay locked), never crashing the withdrawal surface.
model admin_withdrawal_unlocks {
  target_user_id String       @id
  unlocked_by    String?      @db.Uuid
  unlocked_at    DateTime     @default(now()) @db.Timestamptz(6)
  notes          String?
  admin_user     admin_users? @relation(fields: [unlocked_by], references: [id], onDelete: SetNull)

  @@index([unlocked_at(sort: Desc)], map: "admin_withdrawal_unlocks_unlocked_at_idx")
}

/// WebAuthn passkey credentials for admins, usable as an ALTERNATIVE to the
/// TOTP code at the 2FA verification step (password remains factor one; TOTP
/// enrollment is unchanged). One row per registered authenticator. Lives in the
/// ADMIN DB — pure admin-panel data. Provisioned via `prisma db execute`
/// (prisma/admin/sql/2026-06-20_add_admin_passkeys.up.sql); this model is the
/// typed mirror. Do NOT `prisma db push` / `migrate` (would risk dropping
/// un-modeled drift in the admin DB).
model admin_passkeys {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id String      @db.Uuid
  /// Base64URL-encoded credential ID returned by the authenticator. Globally
  /// unique — used to look up the credential at authentication time.
  credential_id String      @unique
  /// COSE-encoded public key bytes (from registrationInfo.credential.publicKey).
  public_key    Bytes
  /// Signature counter — bumped to the authenticator's reported value on each
  /// successful authentication to detect cloned authenticators (replay guard).
  counter       BigInt      @default(0)
  /// Reported transports ("internal", "usb", "hybrid", ...) — hints the browser
  /// on subsequent ceremonies.
  transports    String[]    @default([])
  /// User-supplied label so an admin can tell their devices apart.
  device_name   String?
  /// Whether the credential is a backed-up / multi-device (synced) passkey.
  backed_up     Boolean     @default(false)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  last_used_at  DateTime?   @db.Timestamptz(6)
  admin_user    admin_users @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)

  @@index([admin_user_id])
}

/// Admin-DB metadata for balance adjustments tagged as "Giveaway" on the
/// /users/[id] adjust-balance flow. Stored separately from the main-DB
/// ledger row because:
///   • the source URL (Twitter / Discord) is admin-internal — no reason
///     to expose it on the user-facing ledger,
///   • we can't cross-DB FK into ledger_transactions (different
///     PostgreSQL databases),
///   • the /marketing/giveaway page only needs the admin-side data
///     anyway (user_id + amount + source).
///
/// `ledger_tx_id` is stored as TEXT (not a real FK) so we can still
/// cross-reference each giveaway row back to the ledger event that
/// funded it for auditing — no constraint, just a reference.
model admin_giveaway_actions {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  /// packy.gg user.id (text, not UUID — better-auth nanoid).
  target_user_id String
  /// Signed USD amount that actually landed on the user's balance.
  /// Mirrors the ledger row's `amount` field for self-contained
  /// display on the giveaway page without a cross-DB lookup.
  amount_usd     Decimal     @db.Decimal(20, 2)
  /// Full URL the giveaway was advertised at (tweet / Discord
  /// message). Validated server-side against an allowlist of hosts.
  source_url     String
  /// Derived from `source_url` host at write time. Cached so the
  /// list page doesn't need to re-parse 1000 URLs to draw badges.
  /// One of: "twitter" | "discord" | "other".
  source_type    String
  /// Optional free-text reason the admin entered (mirrors the
  /// `reason` argument to adjustBalance). Useful when multiple
  /// admins want to remember WHY this specific giveaway happened
  /// beyond just the source URL.
  reason         String?
  /// Cross-reference to the main-DB ledger row this giveaway funded.
  /// Stored as TEXT because the main DB lives in a separate Postgres
  /// — Prisma can't enforce a real FK here. Always set in practice
  /// because the giveaway row is only written AFTER the ledger
  /// transaction succeeds.
  ledger_tx_id   String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])

  @@index([created_at(sort: Desc)], map: "admin_giveaway_actions_created_at_idx")
  @@index([target_user_id], map: "admin_giveaway_actions_target_user_id_idx")
}

/// Admin-set VIP tags on packy.gg users. Lives in the admin DB because
/// it's admin-internal CRM metadata — never exposed to the user side
/// and not part of the game DB's user schema (we can't cross-DB FK to
/// the main `user` table anyway).
///
/// Two tags supported today, enforced by the `tag` text + a CHECK
/// constraint at the SQL layer (see migration):
///   • vip — user is flagged as VIP (surfaced on the /vips admin page)
///   • wager_abuser — user is flagged for wager abuse
///
/// (The former `contacted_vip` / `confirmed_vip` pair was consolidated into
/// the single `vip` tag, and `fraud_abuser` was dropped, by the
/// 20260708000000_admin_user_tags_vip_consolidate migration — zero live
/// rows used any of those three values at the time.)
///
/// Each (user, tag) pair is unique — re-tagging is idempotent. Removing
/// a tag is a DELETE; we don't soft-delete because the audit trail
/// already lives in `admin_audit_events`.
model admin_user_tags {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg user_id (text — main DB lives in a separate Postgres
  // cluster, can't be an FK).
  target_user_id  String
  // Tag value — 'vip' | 'wager_abuser'.
  // The set is also enforced server-side in the action (Zod enum) so
  // even if a future code path bypasses the SQL CHECK we still catch
  // bad values.
  tag             String
  // Who set the tag. Used for the audit panel and to know which admin
  // owns a CRM assignment. NULLABLE so deleting the admin who set the tag
  // NULLs the attribution and PRESERVES the tag (the (user,tag) pair is the
  // record; the audit trail of who set it lives in admin_audit_events). The
  // DROP NOT NULL was applied to the admin DB via
  // prisma/admin/sql/2026-06-15_delete_admin_provenance_nullable.up.sql.
  set_by_admin_id String?      @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  admin_user      admin_users? @relation(fields: [set_by_admin_id], references: [id])

  @@unique([target_user_id, tag], map: "admin_user_tags_user_tag_unique")
  @@index([target_user_id], map: "admin_user_tags_target_user_id_idx")
  @@index([tag], map: "admin_user_tags_tag_idx")
}

// Admin-managed blacklist of packy.gg user IDs whose activity should
// NOT count toward dashboard / analytics / PnL / wager metrics. Used
// for excluding internal test accounts, hand-picked outliers, and
// staff users who happen to play. Race-related queries (rakeback,
// leaderboards, race claims) intentionally IGNORE this list — the
// user explicitly asked for races to keep counting blacklisted
// users so leaderboard positions don't shift when an exclusion
// lands.
//
// Storage notes:
//   • Primary key IS the packy.gg user_id — a user can only be
//     excluded once and the row IS the exclusion record.
//   • `excluded_by` references admin_users.id so we know who added
//     each entry. We could soft-delete instead of hard-delete, but
//     the audit table already captures every add/remove event, so a
//     hard delete is fine — the history lives there.
model excluded_users {
  user_id     String      @id
  reason      String?
  // NULLABLE so deleting the admin who excluded this user NULLs the
  // attribution and KEEPS the user excluded (the row IS the exclusion
  // record). DROP NOT NULL applied via
  // prisma/admin/sql/2026-06-15_delete_admin_provenance_nullable.up.sql.
  excluded_by String?      @db.Uuid
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @updatedAt      @db.Timestamptz(6)
  admin_user  admin_users? @relation(fields: [excluded_by], references: [id], onDelete: Restrict)

  @@index([created_at(sort: Desc)], map: "excluded_users_created_at_idx")
}

// Per-user editable "Balance 2.0" annotation surfaced on
// /system/excluded-users. Admin-managed only, never exposed to the
// user side — it's a hand-typed dollar number an operator wants to
// track next to each blacklisted user, independent of the user's real
// on-site balance. Mirrors the visual shape of the "Total Deposited"
// column on that page but is fully editable (the page already requires
// the motha-only gate, so write access is gated identically).
//
// Storage notes:
//   • target_user_id is the packy.gg better-auth nanoid (text — the
//     main DB lives in a separate Postgres cluster, so cross-DB FKs
//     aren't possible). We do NOT relation-link this to excluded_users
//     either, because Balance 2.0 is logically per-user and the
//     excluded_users row could be removed and re-added without losing
//     this annotation.
//   • Primary key IS target_user_id — each user has at most one
//     Balance 2.0 value. setExcludedUserBalanceV2 upserts on this key.
//   • set_by_admin_id references admin_users.id so the table can show
//     "last edited by X on date Y". Loose UUID column (not a Prisma
//     relation on admin_users) so adding this table doesn't perturb
//     existing call sites. ON DELETE RESTRICT in the migration so a
//     value can't be orphaned by deleting the admin who set it.
//   • notes is optional free-text the operator can attach to explain
//     why a particular value was chosen.
//
// Runtime caveat: this table is provisioned via a Prisma migration file
// (prisma/admin/migrations/20260605000000_add_excluded_user_balance_v2/
// migration.sql) which the OWNER applies manually — the admin DB has a
// drifted migration history so we never `migrate deploy` against prod.
// Until the owner runs the migration the runtime read MUST gracefully
// fall back to "no values" instead of crashing (see
// src/lib/excluded-users/fetch.ts and the action in actions.ts — both
// catch P2021/42P01 and degrade to an empty map / a clean error).
model admin_excluded_user_balance_v2 {
  // packy.gg user_id (better-auth nanoid, text). Primary key — one
  // Balance 2.0 row per user.
  target_user_id  String      @id
  // Hand-entered USD amount the operator wants to track. Decimal(20,2)
  // matches every other money column in the admin DB.
  balance_v2      Decimal     @db.Decimal(20, 2)
  // admin_users.id of whoever last set the value. NULLABLE so deleting
  // that admin NULLs the attribution and PRESERVES this Balance 2.0 value
  // (the dollar figure is the data; who set it is provenance). DROP NOT
  // NULL applied via
  // prisma/admin/sql/2026-06-15_delete_admin_provenance_nullable.up.sql.
  set_by_admin_id String?      @db.Uuid
  set_at          DateTime    @default(now()) @db.Timestamptz(6)
  notes           String?
  admin_user      admin_users? @relation(fields: [set_by_admin_id], references: [id], onDelete: Restrict)

  @@index([set_at(sort: Desc)], map: "admin_excluded_user_balance_v2_set_at_idx")
}

// Custom role definitions for the granular-permissions system.
//
// RoleV2 (P0 — see ROLE_REDESIGN_DESIGN.md): the six built-in `admin_role`
// enum values are now ALSO materialized here as `is_system = true` rows,
// keyed by the NEW nullable `system_key` column (the enum value). Custom
// roles created through the admin UI carry `system_key = NULL` +
// `is_system = false` and can be freely edited / deleted. This unifies the
// built-ins and customs into one table while keeping the `admin_role` enum
// (still load-bearing for `admin_users.role` / `roles`). Seeded by
// prisma/admin/seed-rolev2.ts (idempotent, run-once); identity is
// `system_key`, NOT `name` (a live custom row is named "creator manager", so
// the system rows use distinct canonical labels — see the seed).
//
// `capabilities` is a string[] in the same flat vocabulary `allowed_pages`
// uses: page routes ("/users") + `__can_*` capability flags (+ value tokens).
// For a system row it is BYTE-EQUAL to ROLE_BASELINES[enum].tokens
// (src/lib/role-baselines.ts), proven by the parity harness.
//
// The six `*_limit_*` columns are the TYPED per-role limit slots (RoleV2
// P0). All NULL today (limits live per-user in `admin_balance_limits` /
// value tokens); these are the future home of per-role caps and stay NULL
// in this behavior-neutral phase. Decimal(12,2) matches `admin_balance_limits`.
//
// NOTE: applied to the ADMIN DB via `prisma db execute`
// (prisma/admin/sql/2026-06-14_rolev2_columns.up.sql) — NOT a Prisma
// migration (the admin DB has a drifted migration history; never
// `migrate deploy` / `db push` on it). This model block is the MIRROR so
// typed `adminDb.admin_roles.*` queries see the new columns.
model admin_roles {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique
  // Built-in identity. NULL for custom roles (Postgres allows many NULLs
  // under a UNIQUE constraint, so custom rows never collide). When set,
  // this row IS the built-in baseline for that enum value.
  system_key   admin_role?   @unique
  description  String?
  is_system    Boolean       @default(false)
  capabilities String[]      @default([])
  // Per-role landing route (RoleV2 P4). NULL on every row = today's routing
  // (getDefaultRouteForRoles fallback) — strictly behavior-neutral. When set
  // AND valid (a known ADMIN_PAGES key), a NON-admin holder of this role lands
  // here after auth instead of the role's default surface. `admin` is excluded
  // (hard bypass → /dashboard); validation against ALL_PAGE_KEYS guards against
  // redirect loops. Additive nullable column applied via `prisma db execute`
  // (admin DB is db-push-managed) — see prisma/admin/sql/2026-06-15_add_role_landing_route.up.sql.
  landing_route String?
  // Typed per-role limit slots (RoleV2 P0). All NULL in the behavior-neutral
  // foundation phase — wired into enforcement in a later phase.
  balance_limit_daily    Decimal? @db.Decimal(12, 2)
  balance_limit_weekly   Decimal? @db.Decimal(12, 2)
  balance_limit_monthly  Decimal? @db.Decimal(12, 2)
  issuance_limit_daily   Decimal? @db.Decimal(12, 2)
  issuance_limit_weekly  Decimal? @db.Decimal(12, 2)
  issuance_limit_monthly Decimal? @db.Decimal(12, 2)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @updatedAt        @db.Timestamptz(6)
  admin_users  admin_users[]
}

model admin_sessions {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  ip             String?
  user_agent     String?
  auth_method    String?
  logged_in_at   DateTime    @default(now()) @db.Timestamptz(6)
  expires_at     DateTime    @db.Timestamptz(6)
  logged_out_at  DateTime?   @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])
}

model admin_notes {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String      @db.Uuid
  target_user_id String
  content        String
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)
  admin_user     admin_users @relation(fields: [admin_user_id], references: [id])
}

model admin_audit_events {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id  String?      @db.Uuid
  event_type     String
  target_user_id String?
  ip             String?
  metadata       Json?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  admin_user     admin_users? @relation(fields: [admin_user_id], references: [id])

  // Indexes for the /audit viewer + admin/user detail audit tabs. The
  // viewer's headline ordering is `ORDER BY created_at DESC` (no filter on
  // an unfiltered list page), and the toolbar filters by `event_type IN
  // (...)`, `admin_user_id`, and `target_user_id`. Pre-existing composite
  // perf indexes — admin_audit_events_admin_user_created_idx
  // (admin_user_id, created_at DESC) and admin_audit_events_event_type_created_idx
  // (event_type, created_at DESC) — were added in 20260429100000_perf_indexes
  // and remain in place (managed outside this schema with `@@index([col],
  // map: …)` declarations would risk renaming them; we leave the composites
  // unmodeled in Prisma since they were created by raw SQL).
  //
  // The single-column indexes below cover the access patterns the composites
  // don't:
  //   • created_at DESC alone — bare ORDER BY DESC with no filter (the
  //     composites lead with admin_user_id / event_type, so neither
  //     satisfies an unfiltered recency scan).
  //   • event_type — `event_type IN (...)` (multi-value, no following
  //     created_at ordering); also covers groupBy() on event_type for the
  //     /audit Event Types KPI, AND the retune-workspace tuned-count
  //     (getTunedPackCount: event_type IN ('pack_retuned',
  //     'pack_edited_via_retune','pack_edited_and_retuned')). That slice is
  //     single-digit rows, so no JSON/metadata index is warranted.
  //   • admin_user_id — covers the cross-DB join into admin_users without
  //     leading the composite, and partial filters without created_at.
  //   • target_user_id — currently has zero coverage; powers the
  //     target-user filter on /audit and the per-user audit drill-down.
  @@index([created_at(sort: Desc)], map: "admin_audit_events_created_at_idx")
  @@index([event_type], map: "admin_audit_events_event_type_idx")
  @@index([admin_user_id], map: "admin_audit_events_admin_user_id_idx")
