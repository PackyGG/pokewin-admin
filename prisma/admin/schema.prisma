// ─── Crypto fee profit — durable, monotonic high-water counter ─────────
// Backs the dashboard "Crypto Fee" KPI box. The figure is the house's
// estimated cumulative profit from the hidden crypto exchange-rate fee
// (completed crypto deposit/withdrawal USD volume × the avg fee-band
// midpoint), but ANCHORED to a start instant (~2h before seed) and made
// MONOTONIC so it only ever counts UP ("guaranteed profit, can't go
// down").
//
// Why this lives in the ADMIN DB (not computed purely live from the game
// DB): the prod GAME DB has swapped hosts twice this week. A number read
// purely live from game-DB history could DROP if that history moves to a
// fresh/partial host — unacceptable for a "can't go down" counter. So we
// persist the running high-water total here: the query computes the live
// since-anchor volume × LOCKED bps, takes `GREATEST(stored, live)`, and
// writes the high back. The stored value survives a host swap (it holds
// the last high) and the displayed number is provably non-decreasing.
//
// SINGLE-ROW table — one fixed `id = 'singleton'` row, seeded once. The
// owner can edit `count_start_at` (and the locked bps) directly in the
// admin DB to nudge the anchor; the bps are LOCKED here (read once at
// seed time) so a later site_config band change doesn't retroactively
// move historical fee math.
//
// Provisioned in the live admin DB via a surgical `CREATE TABLE IF NOT
// EXISTS` (prisma/admin/sql/20260614_crypto_fee_profit_counter.sql) run
// with `prisma db execute` — NOT a Prisma migration (the admin DB has a
// drifted migration history; never `migrate deploy` on it). This model
// block is the MIRROR so typed `adminDb.crypto_fee_profit_counter.*`
// queries work. The read path catches the missing-table/row error
// (P2021/P2025/42P01) and degrades gracefully.
//
// bps stored as Decimal(7,4) so the withdrawal midpoint's 7.5 (= 0.075%)
// is exact — an INT column would round 7.5 → 8 and silently inflate the
// withdrawal leg.
model crypto_fee_profit_counter {
  // Fixed single-row key. Always 'singleton'.
  id                  String   @id @default("singleton")
  // The anchor: estimated fee profit is counted from this instant only.
  // Seeded to ~2h before now; the owner may edit it to nudge the start.
  count_start_at      DateTime @db.Timestamptz(6)
  // Fee-band midpoints LOCKED at seed time (bps of market price). Read
  // once from site_config so a later band change can't retro-move the
  // historical math. Decimal so 7.5 bps stays exact.
  deposit_fee_bps     Decimal  @db.Decimal(7, 4)
  withdrawal_fee_bps  Decimal  @db.Decimal(7, 4)
  // Running HIGH-WATER total + its split (USD). The query writes back
  // GREATEST(stored, live) so these only ever increase.
  total_fee_usd       Decimal  @default(0) @db.Decimal(20, 2)
  deposit_fee_usd     Decimal  @default(0) @db.Decimal(20, 2)
  withdrawal_fee_usd  Decimal  @default(0) @db.Decimal(20, 2)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// ─── Shift planner ─────────────────────────────────────────────────
// Weekly support-team rota. Each week has up to 3 shifts per day; the
// admin who plans the week sets the concrete start/end instant for each
// shift + tags one or more admin_users as the people on duty. Times
// are stored as absolute UTC Timestamptz so TZ conversion on the client
// is unambiguous — viewers see them in their own preference zone.
model admin_shifts {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Monday 00:00 UTC of the ISO week the shift belongs to. Used as the
  // primary grouping key on reads + for the unique constraint.
  week_start     DateTime                  @db.Timestamptz(6)
  // 0 = Monday … 6 = Sunday (ISO week numbering).
  day_of_week    Int
  // 0, 1, 2 — which of the three daily shift slots this is. Slots are
  // stable across weeks so "slot 0" of this week can be compared to
  // "slot 0" of last week even if the hours changed.
  shift_slot     Int
  // Concrete start / end instants. The pair must fall within the same
  // 24h window rooted at week_start + day_of_week — validated at the
  // action boundary, not via a DB constraint (which would be awkward).
  start_at       DateTime                  @db.Timestamptz(6)
  end_at         DateTime                  @db.Timestamptz(6)
  // Free-form note — "on-call for card withdrawals", "sponsored tourney",
  // etc. Optional.
  notes          String?
  // NULLABLE so deleting the admin who planned this shift NULLs the
  // attribution and PRESERVES the schedule row. DROP NOT NULL applied via
  // prisma/admin/sql/2026-06-15_delete_admin_provenance_nullable.up.sql.
  created_by_id  String?                   @db.Uuid
  created_by     admin_users?              @relation("admin_shifts_created_by", fields: [created_by_id], references: [id])
  assignments    admin_shift_assignments[]
  created_at     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                  @updatedAt @db.Timestamptz(6)

  // One shift per (week, day, slot). Upsert-keyed off this triple.
  @@unique([week_start, day_of_week, shift_slot])
  @@index([week_start])
}

// Many-to-many between shifts and admin_users. Explicit join table (not
// an array column on admin_shifts) so admin user deletion cascades
// cleanly and we keep referential integrity.
model admin_shift_assignments {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shift_id      String       @db.Uuid
  admin_user_id String       @db.Uuid
  shift         admin_shifts @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  admin_user    admin_users  @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([shift_id, admin_user_id])
  @@index([admin_user_id])
}


// ─── Employee salaries (motha-only manual payout register) ────────
// We dropped the on-chain auto-payment system — motha sends USDT
// from their own wallet manually (clicks an employee → QR code of
// the address → scans with their wallet of choice). The DB is now
// just a registry of recipients + a manual log of payments
// recorded after the fact (with optional etherscan tx link).
model salary_employees {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Discord username (`.unique` style or legacy `User#1234`). Stored
  // as plain text — we only use it for display + audit metadata, not
  // for any Discord API auth.
  discord_name     String
  // 0x-prefixed lowercased Ethereum address. Validation happens at
  // the server-action boundary (ethers.isAddress), the column itself
  // is just a String so test addresses / future-other-chain cases
  // don't require a migration.
  eth_address      String
  // Pay frequency. One of "weekly" | "biweekly" | "monthly".
  // Stored as TEXT (no enum) so changing the set of values doesn't
  // require a migration; validated at the action boundary.
  cadence          String              @default("monthly")
  // The employee's recurring salary in USDT (6 decimals). This is the
  // amount paid PER PERIOD (matches the cadence above), not monthly.
  // Monthly equivalent computed at render time.
  salary_usdt      Decimal             @db.Decimal(20, 6)
  // Optional safety cap — refuses any single payout exceeding this
  // amount even if the admin types it explicitly. Catches typos.
  max_per_payout   Decimal?            @db.Decimal(20, 6)
  active           Boolean             @default(true)
  // Legacy weekday pay day (0=Sun…6=Sat). Superseded by
  // pay_day_of_month; kept for back-compat, not used by the UI.
  pay_day_of_week  Int?                @db.SmallInt
  // Recurring pay day as a day of the month (1-31, clamped to the
  // month's length at render). Null = none set.
  pay_day_of_month Int?                @db.SmallInt
  last_paid_at     DateTime?           @db.Timestamptz(6)
  notes            String?
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @updatedAt @db.Timestamptz(6)
  // NULLABLE so deleting the admin who created this employee NULLs the
  // attribution and PRESERVES the financial record. DROP NOT NULL applied
  // via prisma/admin/sql/2026-06-15_delete_admin_provenance_nullable.up.sql.
  created_by_id    String?             @db.Uuid
  created_by       admin_users?        @relation(fields: [created_by_id], references: [id])

  payouts          salary_payouts[]
  payments         salary_payments[]

  @@index([active])
}

model salary_payouts {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id     String           @db.Uuid
  amount_usdt     Decimal          @db.Decimal(20, 6)
  // Captured at send time so a later employee.eth_address rename
  // doesn't rewrite history. Always lowercased.
  to_address      String
  // Null until broadcast succeeds. Indexed unique so a retry can't
  // accidentally double-insert the same on-chain transfer.
  tx_hash         String?          @unique
  // pending → broadcast → confirmed (or failed). Status moves
  // forward only.
  status          String           @default("pending")
  error_message   String?
  broadcast_at    DateTime?        @db.Timestamptz(6)
  confirmed_at    DateTime?        @db.Timestamptz(6)
  failed_at       DateTime?        @db.Timestamptz(6)
  // NULLABLE so deleting the admin who recorded this payout NULLs the
  // attribution and PRESERVES the payout record. DROP NOT NULL applied via
  // prisma/admin/sql/2026-06-15_delete_admin_provenance_nullable.up.sql.
  paid_by_id      String?          @db.Uuid
  paid_by         admin_users?     @relation(fields: [paid_by_id], references: [id])
  created_at      DateTime         @default(now()) @db.Timestamptz(6)

  employee        salary_employees @relation(fields: [employee_id], references: [id])

  @@index([employee_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
}

// Lightweight payment tracking — a saved payment link + date per
// employee. Distinct from the legacy salary_payouts table; this is just
// "who was paid, the link, and when". created_by_id is a loose FK to
// admin_users (DB-level only, no Prisma relation) to keep the admin_users
// model untouched.
model salary_payments {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id   String           @db.Uuid
  payment_link  String
  paid_at       DateTime         @default(now()) @db.Timestamptz(6)
  created_by_id String           @db.Uuid
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  employee      salary_employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@index([paid_at(sort: Desc)])
}

// ─── Employee org board (drag-and-drop workspace grouping) ─────────
// A Kanban-style board (page /employees, all-admin access) where the
// employees from the salary registry are organized into named
// "workspace" columns and tagged with free-form roles. This board is
// broader-access than the founders-only /salaries page, so it stores
// NOTHING sensitive — pay/wallet data never leaves the salary tables.
// Tables are also created via a runtime IF-NOT-EXISTS fallback in
// src/lib/employee-board/ensure-schema.ts (no migration file, matching
// the salary self-heal pattern).
model employee_workspaces {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Display name of the column ("Marketing", "Dev", …).
  name       String
  // Manual ordering of the columns left-to-right.
  position      Int                           @default(0)
  created_at    DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                      @updatedAt @db.Timestamptz(6)
  placements    employee_board_placements[]
  manager_links employee_manager_workspaces[]
}

// One row per (employee, workspace) placement — an employee can be
// placed in multiple sections (someone who handles both areas). Roles
// are per-placement, so the same person can hold different roles in
// different sections. employee_id is salary_employees.id but
// intentionally kept as a LOOSE column (DB-level FK only, no Prisma
// relation field on salary_employees) so the salary model stays
// untouched. workspace_id null = legacy roles-only "Unassigned" row
// (older rows created when an employee had roles but no section);
// new rows created by the multi-section UI always carry a workspace.
model employee_board_placements {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id  String               @db.Uuid
  workspace_id String?              @db.Uuid
  roles        String[]             @default([])
  position     Int                  @default(0)
  created_at   DateTime             @default(now()) @db.Timestamptz(6)
  updated_at   DateTime             @updatedAt @db.Timestamptz(6)
  workspace    employee_workspaces? @relation(fields: [workspace_id], references: [id], onDelete: SetNull)

  // An employee can be placed in any given workspace at most once.
  // Postgres treats NULL workspace_id rows as distinct under unique
  // constraints, so legacy roles-only Unassigned rows are not blocked.
  @@unique([employee_id, workspace_id])
  @@index([workspace_id])
  @@index([employee_id])
}

// An employee promoted to "manager" — rendered in the row above the
// workspace columns. employee_id is salary_employees.id (loose column,
// DB-level FK only, same convention as employee_board_placements). A
// manager can oversee many workspaces via employee_manager_workspaces.
model employee_managers {
  id          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String                        @unique @db.Uuid
  // Manual ordering of the manager blocks left-to-right.
  position    Int                           @default(0)
  created_at  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                      @updatedAt @db.Timestamptz(6)
  workspaces  employee_manager_workspaces[]
}

// Many-to-many link manager ↔ workspace. One row per connector line on
// the board. Both FKs CASCADE so deleting a manager or a workspace
// removes its lines automatically.
model employee_manager_workspaces {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manager_id   String              @db.Uuid
  workspace_id String              @db.Uuid
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  manager      employee_managers   @relation(fields: [manager_id], references: [id], onDelete: Cascade)
  workspace    employee_workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([manager_id, workspace_id])
  @@index([manager_id])
  @@index([workspace_id])
}

// 7-day soft-delete snapshot for main-DB users wiped via the admin
// /users delete action. When an admin clicks Delete User on /users/[id]
// (or bulk-deletes from /users), the deleteUser server action snapshots
// the user row plus the heavier per-user satellite tables (balances,
// inventory, vouchers, rakeback claims, recent ledger / game sessions)
// into this table BEFORE running the destructive main-DB delete. The
// snapshot lives here for 7 days — listed at /users/deleted — and can
// be restored or purged manually. After expires_at the row is purged
// fire-and-forget on the next /users/deleted read.
//
// Storage notes:
//   • id IS the original main-DB user.id (text — better-auth nanoid).
//     A user can only have one active snapshot at a time; re-deleting
//     a user after restore would overwrite the prior row (upsert).
//   • snapshot is the JSONB blob — see src/lib/deleted-users/snapshot.ts
//     for the shape. Bounded to ~5 MB; over-large arrays are truncated
//     with a _truncated marker logged inside the blob.
//   • Cross-DB FKs aren't possible (main DB vs admin DB live on
//     separate Postgres clusters) — deleted_by / restored_by are plain
//     UUIDs that match admin_users.id. We don't relation-link them
//     here either, to keep admin_users untouched.
model admin_deleted_users {
  // Original packy.gg user_id (text — better-auth nanoid).
  id           String    @id @db.VarChar(36)
  // Captured at delete time so the listing UI doesn't need to crack the
  // JSONB blob to render usernames/emails.
  username     String?   @db.VarChar(255)
  email        String?   @db.VarChar(255)
  deleted_at   DateTime  @default(now()) @db.Timestamp(6)
  // admin_users.id of whoever ran the delete. Plain UUID column — no
  // Prisma relation so adding this table doesn't touch admin_users.
  deleted_by   String    @db.VarChar(36)
  // deleted_at + 7 days. Set server-side at insert; listing reads
  // expire-and-purge before rendering. Indexed for the purge scan.
  expires_at   DateTime  @db.Timestamp(6)
  // JSONB blob — { user, balances, user_inventory, vouchers,
  // rakeback_claims, ledger_transactions, game_sessions, _truncated }
  snapshot     Json      @db.JsonB
  // Null until restoreDeletedUser runs. Once set, the snapshot is
  // immutable and cannot be restored again — re-restoring would
  // double-insert. Restored snapshots stay listed (with the restore
  // status visible) until natural expiry.
  restored_at  DateTime? @db.Timestamp(6)
  restored_by  String?   @db.VarChar(36)

  @@index([expires_at], map: "admin_deleted_users_expires_at_idx")
  @@index([deleted_at(sort: Desc)], map: "admin_deleted_users_deleted_at_idx")
}

// Recoverable snapshot of "content" balance-adjustment ledger rows that an
// admin wiped off a user's account via the /users/[id] "Wipe content
// balance adjustments" flow. The owner hands creators admin balance
// adjustments so they can make content (open packs / stream); this lets
// those be cleaned out of a user's account WITHOUT touching real financial
// or gaming history. Hard-delete is the chosen mechanism, so the deleted
// rows are snapshotted here first to keep the operation recoverable.
//
//   • id is the wipe-BATCH id (one row per wipe action, may cover several
//     deleted ledger rows). gen_random_uuid() like every other admin table.
//   • user_id is the main-DB packy.gg user id (better-auth nanoid, text).
//     NOT a Prisma relation — main DB vs admin DB live on separate Postgres
//     clusters, so cross-DB FKs aren't possible. user_id / wiped_by /
//     restored_by are plain text/UUID columns that match the respective
//     ids in their own DBs.
//   • snapshot is the JSONB blob: { userId, rows: ledger_transactions[] }
//     where each row is the full deleted ledger_transactions row with
//     Decimal/Date values serialized to canonical strings — see
//     src/lib/balance-adjustment-wipes/snapshot.ts. Restore re-inserts the
//     rows verbatim and re-adds the summed amount back to the balance.
//   • total_amount is the SUM of the deleted rows' amounts (signed). The
//     wipe REDUCES balances.available_balance by exactly this, so restore
//     ADDS it back. balance_before / balance_after capture the user's
//     available_balance immediately around the wipe for the audit trail.
//   • restored_at is null until restoreBalanceAdjustmentWipe runs. Once
//     set the batch can't be restored again (re-restoring would
//     double-insert + double-credit). Restored batches stay listed with
//     the restore status visible.
//
// Provisioned at runtime via the IF-NOT-EXISTS ensure-schema fallback
// (src/lib/balance-adjustment-wipes/ensure-schema.ts) — NOT a Prisma
// migration, because the admin DB has a drifted migration history. This
// model only mirrors the table so typed queries via
// `adminDb.admin_balance_adjustment_wipes.*` work; keep the two in sync.
model admin_balance_adjustment_wipes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Main-DB user the adjustments were wiped from (better-auth nanoid).
  user_id          String    @db.VarChar(36)
  // Captured at wipe time so the listing UI doesn't have to crack the JSONB.
  username         String?   @db.VarChar(255)
  email            String?   @db.VarChar(255)
  wiped_at         DateTime  @default(now()) @db.Timestamp(6)
  // admin_users.id of whoever ran the wipe. Plain UUID column — no Prisma
  // relation so adding this table doesn't touch admin_users.
  wiped_by         String    @db.VarChar(36)
  // SUM of the deleted rows' signed amounts. The wipe subtracts this from
  // available_balance; restore adds it back. Decimal(20,2) matches the
  // ledger / balance precision.
  total_amount     Decimal   @db.Decimal(20, 2)
  // User's available_balance immediately before / after the wipe.
  balance_before   Decimal   @db.Decimal(20, 2)
  balance_after    Decimal   @db.Decimal(20, 2)
  // How many ledger rows this batch deleted.
  adjustment_count Int
  // JSONB blob — { userId, rows: ledger_transactions[] }. Each row is the
  // full deleted ledger_transactions row, Decimal/Date → canonical string.
  snapshot         Json      @db.JsonB
  // Lifecycle status (dual-DB audit consistency) — same semantics as
  // admin_account_wipes.status. DEFAULT 'completed' back-fills existing rows.
  status           String    @default("completed") @db.VarChar(16)
  // Null until restoreBalanceAdjustmentWipe runs. Once set the batch is
  // immutable + cannot be re-restored.
  restored_at      DateTime? @db.Timestamp(6)
  restored_by      String?   @db.VarChar(36)

  @@index([user_id], map: "admin_balance_adjustment_wipes_user_id_idx")
  @@index([wiped_at(sort: Desc)], map: "admin_balance_adjustment_wipes_wiped_at_idx")
}

// Generalized recovery store for the three NEW account-wipe targets —
// "balance" (zero available_balance), "vault" (zero locked_balance +
// unlock_at), "inventory" (delete user_inventory rows). One table keyed by
// `wipe_type`; the type-specific recovery payload lives in `snapshot`.
//
// Snapshot-FIRST + recoverable, mirroring commit f4bfca0 (the adjustments
// wipe above): the snapshot is written here BEFORE the destructive main-DB
// write, so a wipe is always restorable; once the destructive tx commits it
// is permanent. Restore re-applies the snapshot (re-credit balance /
// re-credit vault / re-insert inventory) and marks restored_at.
//
// Provisioned at runtime via the IF-NOT-EXISTS ensure-schema fallback
// (src/lib/account-wipes/ensure-schema.ts) — NOT a Prisma migration,
// because the admin DB has a drifted migration history. This model only
// mirrors the table so typed queries via `adminDb.admin_account_wipes.*`
// work; keep the two in sync.
model admin_account_wipes {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 'balance' | 'vault' | 'inventory' (AccountWipeType).
  wipe_type   String    @db.VarChar(32)
  // Main-DB user the wipe acted on (better-auth nanoid).
  user_id     String    @db.VarChar(36)
  // Captured at wipe time so the listing UI doesn't have to crack the JSONB.
  username    String?   @db.VarChar(255)
  email       String?   @db.VarChar(255)
  wiped_at    DateTime  @default(now()) @db.Timestamp(6)
  // admin_users.id of whoever ran the wipe. Plain column — no Prisma
  // relation so adding this table doesn't touch admin_users.
  wiped_by    String    @db.VarChar(36)
  // Money removed (balance/vault wipes). 0 for an inventory wipe.
  amount      Decimal   @default(0) @db.Decimal(20, 2)
  // Rows removed (inventory wipe). 0 for a balance/vault wipe.
  item_count  Int       @default(0)
  // JSONB recovery payload — shape depends on wipe_type (see
  // src/lib/account-wipes/snapshot.ts). Decimal/Date → canonical string.
  snapshot    Json      @db.JsonB
  // Lifecycle status (dual-DB audit consistency). 'pending' = snapshot
  // written, finalize not yet confirmed; 'completed' = main-DB delete
  // committed AND (atomically in the admin DB) status flipped + audit row
  // written; 'failed' = main-DB delete failed, snapshot kept as a terminal
  // marker (restore refuses it). DEFAULT 'completed' back-fills existing rows.
  // See src/lib/account-wipes/ensure-schema.ts + finalize.ts.
  status      String    @default("completed") @db.VarChar(16)
  // Null until the matching restore runs. Once set the wipe is immutable +
  // cannot be re-restored.
  restored_at DateTime? @db.Timestamp(6)
  restored_by String?   @db.VarChar(36)

  @@index([user_id], map: "admin_account_wipes_user_id_idx")
  @@index([wiped_at(sort: Desc)], map: "admin_account_wipes_wiped_at_idx")
}

// Rich, admin-only metadata for a STRICT categorized balance adjustment.
//
// The canonical CATEGORY KEY also lives on the MAIN-DB ledger row
// (`metadata.adjustment_category`) — that is what the GGR/NGR/cost queries
// read with NO cross-DB join. THIS table is the audit/detail companion: it
// holds the category-specific inputs (coin type + tx hash, social link,
// exact bonus reason, lossback % + 7d PnL + note) that only make sense in
// the admin panel and never need to be in the main DB. It powers the
// /insights/balance-adjustments detail/audit views.
//
// Provisioned at runtime via the IF-NOT-EXISTS ensure-schema fallback
// (src/lib/balance-adjustment-meta/ensure-schema.ts) — NOT a Prisma
// migration, because the admin DB has a drifted migration history. This
// model only mirrors the table so typed queries via
// `adminDb.admin_balance_adjustment_meta.*` work; keep the two in sync.
model admin_balance_adjustment_meta {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // admin_users.id of whoever made the adjustment. Plain column — no Prisma
  // relation so adding this table doesn't touch admin_users.
  admin_user_id  String   @db.VarChar(36)
  // Main-DB user the balance landed on (better-auth nanoid).
  target_user_id String   @db.VarChar(36)
  // Main-DB ledger_transactions row id this metadata describes. Loose
  // cross-DB reference (separate Postgres — can't be a real FK).
  ledger_tx_id   String   @db.VarChar(36)
  // Canonical category key (BalanceAdjustmentCategory) — also stamped onto
  // the ledger row's metadata. One of:
  // deposit_problem | giveaway | bonus | reload | lossback | other.
  category       String   @db.VarChar(40)
  // Signed USD amount that landed on the user (mirrors the ledger amount)
  // so the detail view doesn't need a cross-DB lookup.
  amount_usd     Decimal  @db.Decimal(20, 2)
  // deposit_problem: the coin + on-chain tx hash that was under-credited.
  coin_type      String?  @db.VarChar(64)
  tx_hash        String?  @db.VarChar(255)
  // giveaway: the Twitter / Discord link the giveaway was sourced from.
  social_link    String?  @db.VarChar(2048)
  // bonus: exact reason (≥20 chars). lossback: optional free-text note.
  reason_text    String?
  // lossback: the % of recent losses credited back.
  lossback_pct   Decimal? @db.Decimal(7, 2)
  // lossback: the user's 7-day PnL value the % was applied against.
  pnl_7d_usd     Decimal? @db.Decimal(20, 2)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@index([target_user_id], map: "admin_balance_adjustment_meta_target_user_id_idx")
  @@index([created_at(sort: Desc)], map: "admin_balance_adjustment_meta_created_at_idx")
  @@index([ledger_tx_id], map: "admin_balance_adjustment_meta_ledger_tx_id_idx")
  @@index([category], map: "admin_balance_adjustment_meta_category_idx")
}

// Admin-side "sponsored %" annotation on a creator (affiliate)
// leaderboard. Purely a cost-accounting input — it does NOT touch the
// backend leaderboard in any way. The /creators "Leaderboard Cost" KPI
// counts each approved leaderboard's prize pool × this percentage;
// leaderboards with no row default to 100% (full cost).
model admin_leaderboard_sponsorship {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg backend affiliate-leaderboard id (uuid string — separate
  // system, can't be an FK). One row per leaderboard; the
  // setLeaderboardSponsorship upsert keys on this.
  leaderboard_id       String   @unique
  // 0–100. Share of this leaderboard's cost the house sponsored.
  // Range is enforced server-side in the action (Zod).
  sponsored_percentage Decimal  @db.Decimal(5, 2)
  // admin_users.id of whoever last set it (plain column — no FK, so
  // adding this table doesn't touch the admin_users model).
  set_by_admin_id      String   @db.Uuid
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
}

// ─── Leaderboard "creator paid his part" flag ──────────────────────
// Admin-side internal tracking flag on a creator (affiliate)
// leaderboard: did the creator actually pay their off-site share?
// Purely a "so we know if he paid or not" annotation — it does NOT
// touch the backend leaderboard, any balance/ledger, or ANY money
// math (PnL / GGR / Leaderboard Cost are unaffected). A dedicated
// table (not a column on admin_leaderboard_sponsorship) so the toggle
// works even for leaderboards that have no sponsorship row yet.
// One row per leaderboard; the setLeaderboardCreatorPaid upsert keys
// on the unique leaderboard_id.
model admin_leaderboard_creator_paid {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg backend affiliate-leaderboard id (uuid string — separate
  // system, can't be an FK). One row per leaderboard.
  leaderboard_id  String    @unique
  // Whether the creator has paid their part. Default false.
  paid            Boolean   @default(false)
  // When `paid` was last flipped to true (cleared back to null when
  // toggled off). Set server-side in the action.
  paid_at         DateTime? @db.Timestamptz(6)
  // admin_users.id of whoever last set it (plain column — no FK, so
  // adding this table doesn't touch the admin_users model).
  set_by_admin_id String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
}

// ─── Changelog entries (admin-panel release notes) ─────────────────
// Curated release notes surfaced at /changelogs. Each row is one self-
// contained "what changed in this release" card. Storage is admin-DB
// only because this is operational/internal content — never shown to
// end users on packy.gg, only to admins inside the panel. The page is
// public-read to anyone with `/changelogs` access; write requires an
// admin role + the `__can_manage_changelog` capability.
//
// Provisioned at runtime via the IF-NOT-EXISTS fallback in
// src/lib/changelog/ensure-schema.ts — there is deliberately NO
// migration file (same convention as employee_workspaces and the
// salary tables, see ensure-schema.ts comment for context on the
// drifted admin-DB migration history).
//
// Fields:
//   • published_at — admin-set "release date" (NOT row-created-at).
//     Lets the same release be backdated or scheduled by hand.
//   • title — short label ("Sets overhaul", "Treasury tile"),
//     rendered as the card headline.
//   • summary — one-paragraph TL;DR. Plain text (markdown-safe but
//     not rendered as markdown — no XSS surface).
//   • version — optional human label ("v2025.11", "Sprint 23").
//   • category — drives the badge color/icon on the card. One of
//     'feature' | 'fix' | 'improvement' | 'breaking' | 'infra'.
//     Enforced server-side via Zod; the column is plain TEXT so a
//     future category doesn't require a DB migration.
//   • changes — array of `{ kind, text }` rows ({ kind: 'feature' |
//     'fix' | 'improvement' | 'breaking' | 'infra', text: string }).
//     Rendered as a per-row bullet list inside the card with a small
//     icon per kind.
//   • author_admin_user_id — who published the entry. Plain UUID
//     column (no Prisma relation to admin_users) to keep the
//     admin_users model untouched, matching the convention used by
//     employee_managers / salary_payments / admin_leaderboard_sponsorship.
model admin_changelog_entries {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  published_at          DateTime @db.Timestamptz(6)
  title                 String
  summary               String
  version               String?
  // Bucketed category — drives badge color + icon on the card.
  category              String
  // jsonb array of { kind: 'feature'|'fix'|'improvement'|'breaking'|'infra',
  // text: string }. Shape validated at the server-action boundary.
  changes               Json     @db.JsonB
  // Loose FK to admin_users.id — no Prisma relation here so adding
  // this table doesn't perturb the admin_users model. Nullable so
  // entries authored by a deleted admin still render.
  author_admin_user_id  String?  @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt        @db.Timestamptz(6)

  @@index([published_at(sort: Desc)], map: "admin_changelog_entries_published_at_idx")
}

// ─── Per-pack "set / pool" assignment (admin categorization) ───────────────
// A pack's /packs pool tab (Pokemon / One Piece / Meme / Rewards) is normally
// DERIVED from the sets of the cards it contains. This table lets an admin
// OVERRIDE that per-pack from the pack editor WITHOUT touching any cards — the
// prod game DB is read-only and has no pack-level set column, so the override
// can only live here. A pack with a row here shows under `pack_set` regardless
// of its cards; packs with no row keep the card-derived classification.
//
// Provisioned at runtime via the IF-NOT-EXISTS fallback in
// src/lib/pack-set-assignments/ensure-schema.ts — NO migration file (drifted
// admin-DB migration history, never `migrate deploy` on it). This model block
// mirrors the table so typed `adminDb.pack_set_assignments.*` queries work;
// read paths catch the missing-table error (P2021 / 42P01) and degrade to
// "no overrides". No real FKs (separate Postgres clusters) — loose columns
// only, matching admin_leaderboard_sponsorship / admin_changelog_entries.
model pack_set_assignments {
  // packy.gg packs.id (uuid). Primary key: one set assignment per pack.
  pack_id         String   @id @db.Uuid
  // Pool key: 'pokemon' | 'onepiece' | 'meme' | 'rewards'. Validated
  // server-side against PACK_POOLS; plain text so adding a pool needs no
  // migration.
  pack_set        String
  // admin_users.id of whoever set it. Loose column (no Prisma relation).
  set_by_admin_id String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([pack_set], map: "pack_set_assignments_pack_set_idx")
}

// ─── Creator Hub substrate (external data + onboarding/CRM/alerts) ──────────
// All tables below are ADMIN-DB only, additive, and provisioned at runtime via
// IF-NOT-EXISTS SQL (prisma/admin/sql/20260606_creator_hub_substrate.sql +
// per-feature ensure-schema.ts) — NOT a Prisma migration, because the admin DB
// has a drifted migration history (never `migrate deploy` on it). These model
// blocks are MIRRORS so typed `adminDb.<table>.*` queries work; every read path
// MUST catch the missing-table error (P2021 / 42P01) and degrade gracefully,
// exactly like src/lib/admin-settings.ts. NO real FKs to admin_users or to
// packy.gg user IDs — loose String / String @db.Uuid columns only (the
// established current convention: salary_payments, employee_managers,
// admin_leaderboard_sponsorship, admin_changelog_entries) so adding these never
// perturbs the admin_users model. RapidAPI keys do NOT live here — they go in
// the existing admin_settings key/value store (server-only, masked in UI).

// Cached Kick channel profile (Bukk/kick-com-api). Keyed on the lowercased
// Kick username so it's shared by both the creator/[id] Kick tab AND the
// "Creator Check" recon tool (which works for ANY handle). Served from DB;
// a Refetch button refreshes on demand. STRICT no-spam: static profile data
// is fetched once → DB and only re-fetched via the manual Refetch button.
model kick_profiles {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Lowercased Kick username — the natural key. Unique so upsert keys on it.
  username        String    @unique
  // Kick's internal channel/user id (string — external system, not an FK).
  kick_user_id    String?
  display_name    String?
  avatar_url      String?
  bio             String?
  follower_count  Int?
  is_verified     Boolean?
  // Last known live snapshot (cheap to keep; the live tab still refetches).
  is_live         Boolean   @default(false)
  // Full raw API payload for fields we don't promote to columns yet.
  raw_json        Json?     @db.JsonB
  // Drives cache/refetch — null = never fetched.
  last_fetched_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([last_fetched_at], map: "kick_profiles_last_fetched_at_idx")
}

// Cached Kick streams / VODs for a channel (Bukk "channel videos" /
// "latest video"). The "live-ish" set the Hub refreshes often. One row per
// stream (keyed by Kick's stream/video id). avg LIVE viewers is NOT available
// from Bukk (owner dropped that requirement) — we store what the API gives
// (date, duration, title, category, replay views, peak if present).
model kick_streams {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Lowercased Kick username this stream belongs to (matches
  // kick_profiles.username — loose link, no FK so a stream can exist before
  // the profile row, and Creator Check works on any handle).
  username         String
  // Kick's stream/video id — the natural per-stream key.
  kick_stream_id   String
  title            String?
  category         String?
  thumbnail_url    String?
  // When the stream started + ended (→ duration). ended_at null = still live.
  started_at       DateTime? @db.Timestamptz(6)
  ended_at         DateTime? @db.Timestamptz(6)
  duration_seconds Int?
  // VOD replay views (NOT live viewers). peak_viewers only if the API
  // surfaces it for that stream; otherwise null.
  vod_views        Int?
  peak_viewers     Int?
  // Replay URL from the API (distinct from the manual per-session VOD URL,
  // which lives on creator_session_meta).
  vod_url          String?
  raw_json         Json?     @db.JsonB
  last_fetched_at  DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // One row per (channel, stream). Upsert keys on this pair.
  @@unique([username, kick_stream_id], map: "kick_streams_username_stream_unique")
  @@index([username, started_at(sort: Desc)], map: "kick_streams_username_started_idx")
}

// Cached Twitter/X profile (RapidAPI twitter241). Keyed on lowercased handle
// so it's shared by the creator/[id] Twitter tab AND Creator Check.
// Static-ish; served from DB with a Refetch button (no auto-poll / no spam).
model twitter_profiles {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Lowercased @handle (without the @) — natural key.
  username        String    @unique
  // Twitter's numeric user id as text (external system, not an FK).
  twitter_user_id String?
  display_name    String?
  avatar_url      String?
  bio             String?
  follower_count  Int?
  following_count Int?
  tweet_count     Int?
  is_verified     Boolean?
  raw_json        Json?     @db.JsonB
  last_fetched_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([last_fetched_at], map: "twitter_profiles_last_fetched_at_idx")
}

// Cached latest tweets per handle (twitter241). The "live-ish" Twitter set
// the Hub refreshes often. Stores tweet text so the 7-day mention scan
// (packydotgg / @packydotgg / packy.gg / … keyword match) runs over OUR DB
// without re-hitting the API.
model tweets {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Lowercased handle this tweet belongs to (matches
  // twitter_profiles.username — loose link, no FK).
  username        String
  // Twitter's tweet id — natural per-tweet key.
  tweet_id        String
  text            String
  // Engagement at fetch time.
  like_count      Int?
  retweet_count   Int?
  reply_count     Int?
  view_count      Int?
  // True if `text` matches any of OUR brand keywords (computed at store time
  // so the 7-day mention COUNT is a cheap WHERE, not a re-scan).
  mentions_us     Boolean   @default(false)
  url             String?
  // Tweet's own publish time (drives the 7-day window) — distinct from
  // created_at (when WE stored it).
  posted_at       DateTime? @db.Timestamptz(6)
  raw_json        Json?     @db.JsonB
  last_fetched_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([username, tweet_id], map: "tweets_username_tweet_unique")
  @@index([username, posted_at(sort: Desc)], map: "tweets_username_posted_idx")
  @@index([username, mentions_us, posted_at(sort: Desc)], map: "tweets_username_mentions_posted_idx")
}

// Brand-mention tracking ledger. One row per tweet that mentions one of our
// keywords (packydotgg / @packydotgg / packygg / packy.gg / …), from ANY
// handle (not only linked creators). Distinct from `tweets` (the per-creator
// cache): this is the brand-monitoring surface. The per-creator 7-day count
// is normally served from tweets.mentions_us; this table backs an optional
// cross-handle "who's talking about us" feed.
model twitter_mentions {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Author handle (lowercased) — loose, no FK.
  username        String
  tweet_id        String
  text            String
  // Which keyword(s) matched — drives filtering/badges.
  matched_keyword String?
  url             String?
  posted_at       DateTime? @db.Timestamptz(6)
  // When this mention sweep last ran for the source it came from.
  last_fetched_at DateTime? @db.Timestamptz(6)
  raw_json        Json?     @db.JsonB
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  // One mention row per tweet — dedupe across repeated sweeps.
  @@unique([tweet_id], map: "twitter_mentions_tweet_unique")
  @@index([posted_at(sort: Desc)], map: "twitter_mentions_posted_idx")
  @@index([username, posted_at(sort: Desc)], map: "twitter_mentions_username_posted_idx")
}

// Per-creator onboarding checklist state (ADMIN-DB; writable). ONE row per
// creator. The AUTO items (>=2 socials, first deal, leaderboard, API key,
// has PFP) are DERIVED from live data at render and are NOT stored here (so
// they can't drift). This table stores the MANUAL toggles + manual inputs +
// a completion snapshot so the panel can auto-hide once everything is done.
model creator_onboarding_checklist {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg user id of the creator (text, no FK). One row per creator.
  target_user_id              String    @unique
  // Manual: "Leaderboard funds collected" (sits below the leaderboard item).
  lb_funds_collected          Boolean   @default(false)
  lb_funds_collected_at       DateTime? @db.Timestamptz(6)
  // Manual: "Twitter giveaway hosted" — toggle + the URL the manager pastes.
  twitter_giveaway_done       Boolean   @default(false)
  twitter_giveaway_url        String?
  // Manual: "Streaming assets provided" toggle/click.
  streaming_assets_provided   Boolean   @default(false)
  // Leaderboard prepaid proof (owner spec): which coin the creator prepaid
  // their % with + the explorer TX link proving the off-site payment. Ties
  // into the lb_funds_collected item.
  lb_prepaid_coin             String?
  lb_prepaid_tx_url           String?
  // Auto-hide snapshot: set when ALL items (auto + manual) are satisfied so
  // the panel stops rendering for this creator. Cleared if an item regresses.
  // The auto items are re-checked at render; this just caches "fully done".
  completed_at                DateTime? @db.Timestamptz(6)
  // Who last touched the manual state (loose admin_users.id column, no FK).
  updated_by                  String?   @db.Uuid
  created_at                  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([completed_at], map: "creator_onboarding_checklist_completed_idx")
}

// Per-creator CRM record (ADMIN-DB). ONE row per creator. Structured CRM
// state only — the free-text contact log REUSES the existing `admin_notes`
// table (keyed on target_user_id), so no new note table is introduced and
// admin_notes is left untouched (it's reused by /users/[id], admin-users,
// fraud).
model creator_crm {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg creator user id (text, no FK). One row per creator.
  target_user_id    String    @unique
  // Account owner = the manager responsible for this creator (admin_users.id,
  // loose column, no FK). Distinct from "who onboarded" (onboarded_by below).
  account_owner_id  String?   @db.Uuid
  // CRM pipeline stage — TEXT (no enum) so the stage set can change without a
  // migration, matching the salary_employees.cadence convention. Validated at
  // the action boundary (Zod). e.g. 'prospect' | 'onboarding' | 'active' |
  // 'paused' | 'churned'.
  stage             String    @default("onboarding")
  // Who did the initial setup/onboarding (the manager who created them).
  // Sourced from the user_made_creator audit event, cached here for display
  // on the Creator tab. Loose admin_users.id column, no FK.
  onboarded_by      String?   @db.Uuid
  onboarded_at      DateTime? @db.Timestamptz(6)
  // Next planned touchpoint (drives a soft "follow up" surface if wanted).
  next_followup_at  DateTime? @db.Timestamptz(6)
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([account_owner_id], map: "creator_crm_account_owner_idx")
  @@index([stage], map: "creator_crm_stage_idx")
}

// Creator Hub "needs attention" alerts — read/dismiss state only. Alert
// CONTENT is derived live from existing data (deal expiring, withdraw cap
// near, leaderboard ending, Risk flag, PnL turned red, big FTD, went live);
// this table persists whether a manager has read/dismissed a given derived
// alert so it isn't re-shown. The dedupe_key (e.g. "deal_expiring:<deal_id>")
// is the idempotency key — the generator upserts on it.
model creator_alerts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Which creator the alert is about (text user id, no FK). Nullable for
  // roster-wide / non-creator-scoped alerts.
  target_user_id  String?
  // Alert type — TEXT (no enum) so new alert kinds don't need a migration.
  // e.g. 'deal_expiring' | 'withdraw_cap_near' | 'leaderboard_ending' |
  // 'risk_flagged' | 'pnl_red' | 'big_ftd' | 'went_live'.
  alert_type      String
  // Stable dedupe key for THIS specific derived alert instance, e.g.
  // "deal_expiring:<deal_id>" or "big_ftd:<ledger_tx_id>". UNIQUE so the
  // generator upserts instead of duplicating on every recompute.
  dedupe_key      String    @unique
  // Severity for sort/badge color — TEXT, validated at boundary.
  // 'info' | 'warning' | 'critical'.
  severity        String    @default("info")
  // Snapshot of the alert payload at generation time (title, value, link), so
  // the list renders without recomputing every derived source.
  metadata        Json?     @db.JsonB
  // Read/dismiss state.
  read_at         DateTime? @db.Timestamptz(6)
  read_by         String?   @db.Uuid
  dismissed_at    DateTime? @db.Timestamptz(6)
  dismissed_by    String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([dismissed_at, severity, created_at(sort: Desc)], map: "creator_alerts_active_idx")
  @@index([target_user_id], map: "creator_alerts_target_user_idx")
}

// Admin-side per-session metadata sidecar. Sessions themselves live in the
// backend/MAIN (read-only) via creatorsApi.listSessions — we can't add columns
// there, so manager-entered per-session data (the Kick VOD URL the owner wants
// inline + in the modal, plus notes) lives here, keyed on the backend session
// id.
model creator_session_meta {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Backend fill/stream session id (string — separate system, not an FK).
  session_id      String    @unique
  // The creator the session belongs to (text user id) — lets us list all
  // session-meta for a creator without round-tripping the backend.
  target_user_id  String
  // Manager-entered Kick VOD URL for this session (inline-editable).
  kick_vod_url    String?
  notes           String?
  updated_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([target_user_id], map: "creator_session_meta_target_user_idx")
}

// ── Product Roadmap (ADMIN-DB) ──────────────────────────────────────
// Internal feature-planning roadmap rendered as a month calendar in the
// Overview section. Each row is a feature block; the detail page links
// Linear issues (live status cached on roadmap_linear_links), user-defined
// detail fields, free-text markdown notes and a links section. Pure
// admin/product data — never touches the MAIN game DB.
enum roadmap_status {
  planned
  in_progress
  shipped
  blocked
  cancelled
}

model roadmap_items {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  status      roadmap_status @default(planned)
  // Calendar placement. Date-only semantics, stored as timestamptz at UTC
  // midnight; end_date is inclusive of the block's last day. NULL on both =
  // an unscheduled backlog idea (ordered by sort_order, not yet on the calendar).
  start_date  DateTime?      @db.Timestamptz(6)
  end_date    DateTime?      @db.Timestamptz(6)
  // Accent color token (a TILE_COLORS key) for the calendar block.
  color       String?
  // Free-text markdown notes shown on the detail page.
  body        String?
  sort_order  Int            @default(0)
  // admin_users.id of the creator (loose column, no FK).
  created_by  String?        @db.Uuid
  archived_at DateTime?      @db.Timestamptz(6)
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  detail_fields roadmap_detail_fields[]
  links         roadmap_links[]
  linear_links  roadmap_linear_links[]

  @@index([archived_at, start_date], map: "roadmap_items_active_idx")
  @@index([start_date, end_date], map: "roadmap_items_range_idx")
}

model roadmap_detail_fields {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id    String        @db.Uuid
  label      String
  value      String
  sort_order Int           @default(0)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  item       roadmap_items @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id], map: "roadmap_detail_fields_item_idx")
}

model roadmap_links {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id    String        @db.Uuid
  label      String
  url        String
  sort_order Int           @default(0)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  item       roadmap_items @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id], map: "roadmap_links_item_idx")
}

model roadmap_linear_links {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id         String        @db.Uuid
  // Linear issue UUID + cached snapshot for offline/fallback rendering.
  linear_issue_id String
  identifier      String
  title           String
  url             String
  state_name      String?
  state_type      String?
  state_color     String?
  assignee_name   String?
  synced_at       DateTime      @default(now()) @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  item            roadmap_items @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([item_id, linear_issue_id], map: "roadmap_linear_links_item_issue_key")
  @@index([item_id], map: "roadmap_linear_links_item_idx")
}

// ─── Pack risk scores (admin-computed pack analytics) ──────────────────────
// One row per pack holding the latest computed risk/edge metrics for a pack.
// Pure admin/product data derived from the (read-only) MAIN pack definition —
// MAIN has no place to store these, so the computed snapshot lives here. The
// upsert keys on the unique pack_id (one current score per pack). No real FK
// to packs (separate Postgres clusters) — loose pack_id column only, matching
// pack_set_assignments / admin_leaderboard_sponsorship.
model pack_risk_scores {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg packs.id (uuid string — separate system, not an FK). UNIQUE:
  // one current risk score per pack; the writer upserts on this.
  pack_id     String   @unique
  // Pack edge (1 − EV/price), e.g. 0.1099 = 10.99%.
  edge        Decimal  @db.Decimal(8, 4)
  // Coefficient of variation of the pack's payout distribution.
  cv          Decimal  @db.Decimal(8, 4)
  // Probability a pull is a net win for the user.
  win_rate    Decimal  @db.Decimal(6, 4)
  // Probability of a "near miss" outcome.
  near_miss   Decimal  @db.Decimal(6, 4)
  // Largest single payout value (USD).
  max_win     Decimal  @db.Decimal(20, 2)
  // Largest payout as a multiple of the pack price.
  max_mult    Decimal  @db.Decimal(12, 4)
  // Composite 0–100 risk score.
  risk_score  Int
  // Risk tier label (e.g. 'low' | 'medium' | 'high'). Plain text so the set
  // can change without a migration; validated at the writer boundary.
  tier        String
  // Compliance check payload (per-rule pass/fail + details).
  compliance  Json
  computed_at DateTime @default(now()) @db.Timestamptz(6)
}

// ─── Pack change-history snapshots (price + every card weight before a write) ──
// One row captured BEFORE each MAIN pack write that changes a pack's price or
// per-card weights (edit / reprice / retune / build), plus one captured at the
// start of a revert. Each row is the FULL prior state of the pack — the exact
// thing the owner can REVERT the pack back to. Pure admin/product data derived
// from the (read-only) MAIN pack definition: MAIN has no place to store change
// history, so the snapshot lives here. No real FK to packs / admin_users
// (separate Postgres clusters) — loose `pack_id` / `captured_by` columns only,
// matching pack_risk_scores / pack_set_assignments.
//
// Provisioned in the live admin DB via `prisma db push` (the admin DB is
// db-push-managed; never `migrate deploy` on it). This model block is the
// authoritative shape so typed `adminDb.pack_state_snapshots.*` queries work.
model pack_state_snapshots {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // packy.gg packs.id (uuid string — separate system, not an FK).
  pack_id     String
  captured_at DateTime @default(now()) @db.Timestamptz(6)
  // admin_users.id of whoever triggered the write this snapshot precedes.
  // Loose column (no Prisma relation) — same convention as pack_risk_scores.
  captured_by String   @db.Uuid
  // What write this state was captured BEFORE: "edit" | "reprice" | "retune"
  // | "revert" | "build". Plain text so the set can grow without a migration;
  // set at the call boundary.
  action      String
  // The pack's price at capture time. Decimal(20,2) matches the MAIN pack
  // price + every money column in the admin DB.
  price       Decimal  @db.Decimal(20, 2)
  // The FULL card pool at capture time: an array of
  // { card_id, weight, color, animation, order } — exactly what a revert
  // re-writes into pack_cards. JSONB so the whole pool is one atomic row.
  cards       Json     @db.JsonB
  // The PackRisk breakdown at capture time (optional — best-effort, may be
  // absent if risk couldn't be computed). Lets the history UI show the
  // pack's edge/CV/win-rate at each point without recomputing.
  risk        Json?    @db.JsonB
  // The pack's `packs.tags` (pack_tag[] as DB strings, e.g. ["%5"]) at capture
  // time — captured so a revert restores the tag the tag-control write may have
  // changed. Nullable: snapshots taken before the tag control shipped have no
  // recorded tags, and a revert leaves the tag untouched in that case (it can't
  // fabricate a prior tag it never captured).
  tags        Json?    @db.JsonB
  // Optional free-text note (e.g. the revert target id, or operator context).
  note        String?

  @@index([pack_id, captured_at(sort: Desc)], map: "pack_state_snapshots_pack_captured_idx")
  // Serves the persistent "Tuned: X / N" workspace counter — a distinct
  // pack_id count filtered by action IN ('edit','retune') (getTunedPackCount).
  @@index([action, pack_id], map: "pack_state_snapshots_action_pack_idx")
}

// ─── Pack Studio — Retune / Edit / Reprice DRAFTS (staging layer) ─────────
// One pending DRAFT per source pack — the operator stages a retune / edit /
// reprice on a draft, then "Push to prod" wraps the existing paranoid
// `applyPackEdit` (`src/app/(pack-studio)/pack-studio/doctor/retune-actions.ts`)
// so EVERY server-side guard still fires (fresh re-read of MAIN, every cardId
// validated against `cards`, EDIT_EDGE_FLOOR backstop, pack_state_snapshots
// capture, transactional delete-all-then-createMany write to pack_cards, audit
// `pack_edited_via_retune`, ADMIN risk-row refresh).
//
// Strict scope: ADMIN-DB only — the draft itself NEVER touches MAIN. Only
// `pushDraftToProd` writes to MAIN, and it does so via the existing live
// writer. NO 2FA on this surface (per owner request 2026-06-27): the operator
// allowlist (`isPackStudioRetuneOperator` in `src/lib/reprice-access.ts` →
// owners + demee) is the gate. The push path mints a synthetic retune token
// internally to satisfy `verifyRetuneToken` inside `applyPackEdit` without
// requiring a TOTP code from the operator.
//
// At most ONE pending draft per pack — enforced by a PARTIAL UNIQUE INDEX
// (`pack_retune_drafts_one_pending_per_pack`) created via `prisma db execute`
// alongside `db push` (Prisma can't model partial uniques). Pushed / discarded
// rows STAY in this table as a lightweight audit ("what did demee push last
// week?") and don't collide with a fresh draft for the same pack.
//
// Provisioned via `prisma db push --schema=prisma/admin/schema.prisma
// --config=prisma/admin/prisma.config.ts` (admin DB is db-push-managed; NEVER
// `migrate deploy` / `migrate dev` on it — would force a destructive reset).
model pack_retune_drafts {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // packy.gg packs.id (uuid string — separate Postgres cluster, not an FK;
  // same convention as pack_risk_scores / pack_state_snapshots).
  pack_id             String   @db.Uuid

  // Lifecycle: 'draft' | 'pushed' | 'discarded'. Plain text (no Prisma enum)
  // so the set can grow without a migration; validated at the action boundary.
  status              String   @default("draft")

  // The proposed new sticker price. Decimal(20,2) matches packs.price and
  // every money column in this DB (pack_state_snapshots.price, …). For a
  // pure pool-edit draft this is the source pack's price at seed time (NOT
  // null) so a push always carries a resolved price — `applyPackEdit` treats
  // `price: undefined` as "leave unchanged"; writing the same number is a
  // no-op equivalent. Keeping it non-null keeps the type one shape.
  proposed_price      Decimal  @db.Decimal(20, 2)

  // The full proposed card pool. JSONB array of
  //   { cardId: uuid, weight: int>0, color: string|null, animation: bool, order: int>=0 }
  // — byte-identical to `applyPackEdit`'s EditPoolInput shape. Weights are
  // positive INTEGERs (matches the pack_cards.weight INT4 column + the
  // Number.isInteger validation in applyPackEdit / shapeWeights). Zod-validated
  // on every write so a buggy client payload can't write malformed JSON.
  proposed_pool       Json     @db.JsonB

  // PackRisk shape (computePackRisk output) for the proposed pool at
  // proposed_price. Cached so the list / diff page renders without re-running
  // math; recomputed on every updateDraftPool / applyAutoRetuneToDraft call so
  // it can never drift from proposed_pool / proposed_price.
  computed_risk       Json     @db.JsonB

  // Snapshot of the source MAIN pack at draft-creation time:
  //   { price: number, pool: EditPoolCard[], risk: PackRisk | null,
  //     name: string, slug: string, packType: string, active: boolean }
  // Lets the BEFORE side of the diff render from admin DB only (no MAIN read
  // on the drafts page). At push time `applyPackEdit` re-reads fresh MAIN
  // (defense in depth); this snapshot is purely for the diff UI and for
  // optional drift detection.
  source_snapshot     Json     @db.JsonB

  // Free-text operator note (why this draft exists, what's being tested).
  notes               String?

  // Provenance. admin_users.id of the operator who seeded vs. last edited.
  // Loose UUID columns — no Prisma relation on admin_users (same convention
  // as pack_state_snapshots.captured_by) so adding this table doesn't perturb
  // the admin_users model. NOT nullable on create; if the admin user is
  // later deleted, attribution dangles (same trade-off pack_state_snapshots
  // accepts).
  created_by          String   @db.Uuid
  last_edited_by      String   @db.Uuid

  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  last_edited_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // Push lifecycle. Set when pushDraftToProd succeeds (status → 'pushed').
  pushed_at           DateTime? @db.Timestamptz(6)
  pushed_by           String?   @db.Uuid

  // Discard lifecycle. Set when discardDraft runs (status → 'discarded').
  discarded_at        DateTime? @db.Timestamptz(6)
  discarded_by        String?   @db.Uuid

  // Indexes:
  //   • pack_id alone — every lookup keys off it (seed / push / edit /
  //     diff-by-pack). Frequent point lookup.
  //   • (status, last_edited_at DESC) — drives the /pack-studio/drafts list
  //     query (`WHERE status='draft' ORDER BY last_edited_at DESC`,
  //     Active-Timeframe-Only: only pending drafts on the list page; pushed
  //     / discarded rows live behind a separate History tab).
  //   • created_at DESC — bare recency for audit/history view.
  //
  // NOTE: the "at most one PENDING draft per pack" rule is enforced by a
  // PARTIAL UNIQUE INDEX (`pack_retune_drafts_one_pending_per_pack` ON
  // (pack_id) WHERE status = 'draft') created via `prisma db execute`
  // alongside `db push`. Prisma can't model partial uniques, so the action
  // layer catches P2002 on seed to surface "a pending draft already exists
  // for this pack" cleanly.
  @@index([pack_id], map: "pack_retune_drafts_pack_id_idx")
  @@index([status, last_edited_at(sort: Desc)], map: "pack_retune_drafts_status_edited_idx")
  @@index([created_at(sort: Desc)], map: "pack_retune_drafts_created_at_idx")
}
