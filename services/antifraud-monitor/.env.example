# Read-only MAIN source. In production this must use MIRROR_PRODUCTION_DB.
SOURCE_DATABASE_URL=postgresql://read_only_source
SOURCE_DATABASE_SSL=disable
SOURCE_DATABASE_CA=
# Optional read-only dev mirror used only by env=dev Fiat eligibility checks.
FIAT_ELIGIBILITY_DEV_SOURCE_DATABASE_URL=
FIAT_ELIGIBILITY_DEV_SOURCE_DATABASE_SSL=disable
FIAT_ELIGIBILITY_DEV_SOURCE_DATABASE_CA=
# Dev-only battle outcome simulator. Both are required together; never point
# this URL at production and never expose the pepper in an API response.
BATTLE_TEST_DEV_DATABASE_URL=
BATTLE_TEST_DEV_SERVER_SEED_PEPPER=
ANTIFRAUD_DATABASE_URL=postgresql://antifraud
ANTIFRAUD_DATABASE_SSL=disable
ANTIFRAUD_DATABASE_CA=
REDIS_URL=redis://redis
FINGERPRINT_SECRET_API_KEY=
FINGERPRINT_REGION=eu
PROXYCHECK_API_KEY=
ABSTRACT_IP_INTELLIGENCE_API_KEY=
ABSTRACT_EMAIL_REPUTATION_API_KEY=
# MaxMind minFraud Factors server credentials. Never expose the license key to browsers.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# HMAC secret configured for the MaxMind alert webhook.
MAXMIND_ALERT_WEBHOOK_SECRET=

# Backend-owned per-user Fiat controller. The Config page uses these through
# the monitor's durable existing-account rollout and new-signup policy.
FIAT_ACCESS_API_BASE_URL=https://packy.gg/v1
ADMIN_API_KEY=
xbypasssecret=
API_TOKEN=
API_ADMIN_TOKEN=
# Dedicated machine credentials for the environment-isolated Fiat endpoint.
FIAT_ELIGIBILITY_DEV_API_KEY=
FIAT_ELIGIBILITY_PROD_API_KEY=
FIAT_ELIGIBILITY_GLOBALLY_ENABLED=false
# Automatic account containment for enforced denials. Unset means ON; set to
# "false" to assess and deny while withholding the Fiat/withdrawal locks.
FIAT_ELIGIBILITY_CONTAINMENT_ENABLED=true
FIAT_ELIGIBILITY_RATE_LIMIT_PER_MINUTE=120
PUBLIC_BASE_URL=http://localhost:4100
ANTIFRAUD_DASHBOARD_URL=https://fraud.packydash.com/monitor
ANTIFRAUD_INGEST_URL=https://fraud.packydash.com/api/antifraud/ingest
ANTIFRAUD_INGEST_SECRET=
# Railway-to-Vercel outage probe. Outage alerts are queued as
# `antifraud.error.webapp` on the Discord bot route, like every other alert.
ANTIFRAUD_WEBAPP_HEALTH_URL=https://fraud.packydash.com/api/health/antifraud-webapp
ADMIN_GUILD_ID=1483064422778798112
FIAT_ALERT_DASHBOARD_URL=https://fraud.packydash.com/fiat-deposits
ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=300
API_WRITE_RATE_LIMIT_PER_MINUTE=30
WS_TICKET_RATE_LIMIT_PER_MINUTE=30
TZ=UTC
POLL_INTERVAL_MS=1000
POLLER_LIVENESS_TIMEOUT_MS=120000
MONITOR_DURATION_SECONDS=300
MONITOR_START_SCORE=21
PORT=4100
