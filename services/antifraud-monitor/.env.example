# Read-only MAIN source. In production this must use MIRROR_PRODUCTION_DB.
SOURCE_DATABASE_URL=postgresql://read_only_source
SOURCE_DATABASE_SSL=disable
SOURCE_DATABASE_CA=
ANTIFRAUD_DATABASE_URL=postgresql://antifraud
ANTIFRAUD_DATABASE_SSL=disable
ANTIFRAUD_DATABASE_CA=
REDIS_URL=redis://redis
FINGERPRINT_SECRET_API_KEY=
FINGERPRINT_REGION=eu
PROXYCHECK_API_KEY=
API_TOKEN=
API_ADMIN_TOKEN=
PUBLIC_BASE_URL=http://localhost:4100
ANTIFRAUD_DASHBOARD_URL=https://fraud.packydash.com/monitor
ANTIFRAUD_INGEST_URL=https://fraud.packydash.com/api/antifraud/ingest
ANTIFRAUD_INGEST_SECRET=
# Optional Discord channel webhook for antifraud alerts. Keep the URL secret.
# ANTIFRAUD_DISCORD_WEBHOOK_URL=
# Blocking and high-risk fiat channel: withdrawal holds, high-risk deposits,
# locked-account deposits, and blacklisted signup/checkout email domains.
# ANTIFRAUD_WITHDRAWAL_HOLD_DISCORD_WEBHOOK_URL=
# Dedicated failed/problem Whop fiat-deposit channel. Keep the URL secret.
# FIAT_ALERT_DISCORD_WEBHOOK_URL=
FIAT_ALERT_DASHBOARD_URL=https://admin.packydash.com/fiat?tab=payments
ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=300
API_WRITE_RATE_LIMIT_PER_MINUTE=30
WS_TICKET_RATE_LIMIT_PER_MINUTE=30
TZ=UTC
POLL_INTERVAL_MS=1000
POLLER_LIVENESS_TIMEOUT_MS=120000
MONITOR_DURATION_SECONDS=180
MONITOR_START_SCORE=25
PORT=4100
