/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but DO track the committed template (no secrets — keys only).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# admin frontend (separate repo)
admin-frontend/
admin-frontend.zip
bun.lock
.codex
.env*.local

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/src/generated
/.claude

# Responsive audit harness artifacts (annotated screenshots + JSON reports)
/audit-artifacts/

# Temporary read-only DB probe / verify scripts (node --env-file=.env + pg).
# These touch the LIVE prod DB and must NEVER be committed — a stray
# `git add -A` would otherwise pull them (and the connection string they load)
# into history. Kept uncommitted + deleted after use.
# Extension-agnostic on purpose: a stray `_probe-*.ts` at the repo root is
# picked up by the tsconfig `**/*.ts` include and FAILS the type-check phase of
# every `next build` (this happened — a leftover _probe-fleet-run.ts broke the
# build). Matching all extensions keeps them out of git; the tsconfig `exclude`
# below keeps them out of the build program.
_probe-*
_verify-*
