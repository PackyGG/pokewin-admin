# Vercel Edge Config connection string (read-heavy config + feature flags).
# Injected automatically by the Vercel Edge Config integration in prod/preview;
# run `vercel env pull .env.local` to sync it locally. Leave blank for local
# dev — the app falls back gracefully (see src/lib/edge-config.ts).
EDGE_CONFIG=

# ─── ClickHouse Cloud (read engine) — SERVER-ONLY, never NEXT_PUBLIC_ ──────────
# The admin dashboard READS analytics from ClickHouse (CDC-mirrored from
# Postgres). Leave blank to keep ClickHouse DORMANT — every read transparently
# falls back to Postgres and behavior is identical (see src/lib/clickhouse/).
# All four are required to enable ClickHouse. Never commit real values.
CLICKHOUSE_URL=
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Per-surface read-source override (optional). Values: off | comparison | clickhouse.
# Default is `off` (Postgres) for every surface until explicitly flipped — via
# Edge Config key `admin-read-source:<surface>` or this env. Example (Dashboard
# today-KPIs PoC): ADMIN_READ_SOURCE__DASHBOARD_TODAY=comparison

# ─── Upstash Redis (shared cache + rate limiting) — SERVER-ONLY ────────────────
# Optional shared, cross-instance cache + rate limiter (see src/lib/cache/redis.ts).
# DORMANT BY DEFAULT: leave blank and every cache/rate-limit call degrades to a
# pure pass-through (limiter fails open, cache computes fresh) — behavior is
# identical to not having it. The Vercel "Upstash for Redis" Marketplace
# integration injects the KV_REST_API_* names; a native Upstash setup uses the
# UPSTASH_REDIS_REST_* names. Provide either pair (URL + token). Never commit
# real values. Do NOT use REDIS_URL/KV_URL (TCP) — the SDK speaks the REST API.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
