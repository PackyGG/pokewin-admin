{
	"name": "packygg-temp",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "prisma generate && prisma generate --schema=prisma/admin/schema.prisma --config=prisma/admin/prisma.config.ts && next dev --turbopack",
		"prebuild": "node scripts/generate-changelog.mjs",
		"build": "prisma generate && prisma generate --schema=prisma/admin/schema.prisma --config=prisma/admin/prisma.config.ts && next build --turbopack",
		"start": "next start",
		"lint": "eslint",
		"changelog:regen": "node scripts/generate-changelog.mjs",
		"admin:migrate": "prisma migrate dev --schema=prisma/admin/schema.prisma --config=prisma/admin/prisma.config.ts",
		"admin:seed": "npx tsx prisma/admin/seed.ts",
		"admin:seed-rolev2": "npx tsx prisma/admin/seed-rolev2.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:seed": "npx tsx e2e/helpers/seed-e2e-admin.ts",
		"test:parity": "tsx --test \"scripts/__fixtures__/*.test.ts\" && node --env-file=.env scripts/limits-parity-harness.mjs",
		"parity:harness": "node --env-file=.env scripts/permission-parity-harness.mjs",
		"limits:harness": "node --env-file=.env scripts/limits-parity-harness.mjs"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@prisma/adapter-pg": "^7.5.0",
		"@prisma/client": "^7.5.0",
		"@tanstack/react-table": "^8.21.3",
		"@upstash/redis": "^1.38.0",
		"@vercel/edge-config": "^1.4.3",
		"bcryptjs": "^3.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"d3-geo": "^3.1.1",
		"date-fns": "^4.1.0",
		"i18n-iso-countries": "^7.14.0",
		"imagekit": "^6.0.0",
		"jose": "^6.2.1",
		"lucide-react": "^0.577.0",
		"next": "15.5.12",
		"next-themes": "^0.4.6",
		"ogl": "^1.0.11",
		"otpauth": "^9.5.0",
		"pg": "^8.20.0",
		"prisma": "^7.5.0",
		"qrcode": "^1.5.4",
		"react": "19.1.0",
		"react-datasheet-grid": "^4.11.6",
		"react-dom": "19.1.0",
		"recharts": "^2.15.4",
		"shadcn": "^4.0.6",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"topojson-client": "^3.1.0",
		"tw-animate-css": "^1.4.0",
		"world-atlas": "^2.0.2",
		"ws": "^8.20.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4",
		"@types/bcryptjs": "^2.4.6",
		"@types/d3-geo": "^3.1.0",
		"@types/node": "^20",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/topojson-client": "^3.1.5",
		"@types/ws": "^8.18.1",
		"dotenv": "^17.4.2",
		"eslint": "^9",
		"eslint-config-next": "15.5.12",
		"jsrepo": "^3.6.2",
		"tailwindcss": "^4",
		"tsx": "^4.21.0",
		"typescript": "^5",
		"vercel": "^54.9.1"
	}
}
